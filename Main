    halloweenGroup.BorderSizePixel = 0; halloweenGroup.LayoutOrder = 1; halloweenGroup.Parent = eventScroll
    Instance.new("UICorner",halloweenGroup).CornerRadius = UDim.new(0,10)
    local hgStroke = Instance.new("UIStroke",halloweenGroup); hgStroke.Color = Color3.fromRGB(160,90,255); hgStroke.Thickness = 1.5
    local hgPad = Instance.new("UIPadding",halloweenGroup)
    hgPad.PaddingTop = UDim.new(0,10); hgPad.PaddingBottom = UDim.new(0,10)
    hgPad.PaddingLeft = UDim.new(0,10); hgPad.PaddingRight = UDim.new(0,10)
    local hgLayout = Instance.new("UIListLayout",halloweenGroup); hgLayout.Padding = UDim.new(0,6); hgLayout.SortOrder = Enum.SortOrder.LayoutOrder

    local hgTitle = Instance.new("TextLabel")
    hgTitle.Size = UDim2.new(1,0,0,24); hgTitle.BackgroundTransparency = 1
    hgTitle.Text = "🎃 Halloween 2026"; hgTitle.TextColor3 = Color3.fromRGB(255,180,80)
    hgTitle.Font = Enum.Font.GothamBlack; hgTitle.TextSize = 16
    hgTitle.TextXAlignment = Enum.TextXAlignment.Left; hgTitle.LayoutOrder = 0; hgTitle.Parent = halloweenGroup

    local hgContent = Instance.new("Frame")
    hgContent.Size = UDim2.new(1,0,0,0); hgContent.AutomaticSize = Enum.AutomaticSize.Y
    hgContent.BackgroundTransparency = 1; hgContent.LayoutOrder = 1; hgContent.Parent = halloweenGroup
    local hgCLayout = Instance.new("UIListLayout",hgContent)
    hgCLayout.Padding = UDim.new(0,6); hgCLayout.SortOrder = Enum.SortOrder.LayoutOrder

    -- Helper: Farm mode row (Fly / TP)
    local function makeFarmModeRow(parent, order)
        local holder = Instance.new("Frame")
        holder.Size = UDim2.new(1,0,0,30); holder.BackgroundTransparency = 1
        holder.LayoutOrder = order; holder.Parent = parent

        local mode = "fly"
        local flyBtn = Instance.new("TextButton")
        flyBtn.Size = UDim2.new(0.5,-3,1,0); flyBtn.BackgroundColor3 = Color3.fromRGB(80,200,120)
        flyBtn.BorderSizePixel = 0; flyBtn.Text = "Fly"; flyBtn.TextColor3 = Color3.fromRGB(15,15,20)
        flyBtn.Font = Enum.Font.GothamBold; flyBtn.TextSize = 12; flyBtn.Parent = holder
        Instance.new("UICorner",flyBtn).CornerRadius = UDim.new(0,5)

        local tpBtn = Instance.new("TextButton")
        tpBtn.Size = UDim2.new(0.5,-3,1,0); tpBtn.Position = UDim2.new(0.5,3,0,0)
        tpBtn.BackgroundColor3 = Color3.fromRGB(50,50,62); tpBtn.BorderSizePixel = 0
        tpBtn.Text = "TP"; tpBtn.TextColor3 = Color3.fromRGB(220,220,230)
        tpBtn.Font = Enum.Font.GothamBold; tpBtn.TextSize = 12; tpBtn.Parent = holder
        Instance.new("UICorner",tpBtn).CornerRadius = UDim.new(0,5)

        local function render()
            if mode=="fly" then
                flyBtn.BackgroundColor3=Color3.fromRGB(80,200,120); flyBtn.TextColor3=Color3.fromRGB(15,15,20)
                tpBtn.BackgroundColor3=Color3.fromRGB(50,50,62); tpBtn.TextColor3=Color3.fromRGB(220,220,230)
            else
                tpBtn.BackgroundColor3=Color3.fromRGB(80,200,120); tpBtn.TextColor3=Color3.fromRGB(15,15,20)
                flyBtn.BackgroundColor3=Color3.fromRGB(50,50,62); flyBtn.TextColor3=Color3.fromRGB(220,220,230)
            end
        end
        flyBtn.MouseButton1Click:Connect(function() mode="fly"; render() end)
        tpBtn.MouseButton1Click:Connect(function() mode="tp"; render() end)
        render()
        return { get = function() return mode end }
    end

    local function enableFarmSupport()
        startAntisit(); startNoclip(); startFly()
        if State.mainToggles.antisit then State.mainToggles.antisit.setActive(true) end
        if State.mainToggles.noclip then State.mainToggles.noclip.setActive(true) end
        if State.mainToggles.fly then State.mainToggles.fly.setActive(true) end
    end
    local function disableFarmSupport()
        stopAntisit(); stopNoclip(); stopFly()
        if State.mainToggles.antisit then State.mainToggles.antisit.setActive(false) end
        if State.mainToggles.noclip then State.mainToggles.noclip.setActive(false) end
        if State.mainToggles.fly then State.mainToggles.fly.setActive(false) end
    end

    local function runCollectFarm(opts)
        local active = true
        local visited = {}
        local counter = 0
        local mode = opts.modeRef
        task.spawn(function()
            while active and State.running do
                local folder = opts.folderFn()
                if not folder then break end
                local unvisited = {}
                for _, obj in ipairs(folder:GetChildren()) do
                    if (obj:IsA("Model") or obj:IsA("BasePart")) and not visited[obj] then
                        table.insert(unvisited, obj)
                    end
                end
                if #unvisited == 0 then break end
                local hrp = getHRP()
                if hrp and mode.get()=="tp" then
                    table.sort(unvisited, function(a,b)
                        local pa,pb = getPosition(a), getPosition(b)
                        if not pa or not pb then return false end
                        return (pa-hrp.Position).Magnitude < (pb-hrp.Position).Magnitude
                    end)
                end
                for _, obj in ipairs(unvisited) do
                    if not active then break end
                    if visited[obj] or not obj.Parent then
                        visited[obj] = true
                    else
                        local pos = getPosition(obj)
                        if pos then
                            visited[obj] = true
                            if mode.get()=="tp" then
                                teleportToExact(pos); task.wait(0.25)
                            else
                                travelTo(pos, function() return not active end); task.wait(0.5)
                            end
                            counter = counter + 1
                            opts.onCounter(counter)
                        end
                    end
                end
            end
            if active then active = false; opts.onComplete(counter) end
        end)
        return function() active = false end
    end

