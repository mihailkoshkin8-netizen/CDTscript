    deviceVal.Text=DEVICE.." ("..PLATFORM_NAME..")"

    local fpsC,fpsT=0,0
    State.statConn=RunService.RenderStepped:Connect(function(dt)
        fpsC=fpsC+1; fpsT=fpsT+dt
        if fpsT>=1 then
            local f=math.floor(fpsC/fpsT+0.5); fpsC,fpsT=0,0
            pcall(function() fpsVal.Text=tostring(f) end)
        end
    end)

    task.spawn(function()
        while State.running do
            local p=getPing()
            pingVal.Text=p>=0 and (tostring(p).." ms") or "N/A"
            task.wait(1)
        end
    end)

