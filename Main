    local function isBarnFind(name)
        local num=name:match("^BarnFindPart(%d+)$")
        if not num then return false end
        local n=tonumber(num); return n and n>=1 and n<=20
    end
    local function refreshBarnList()
        for _,c in ipairs(barnListHolder:GetChildren()) do
            if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then c:Destroy() end
        end
        local found={}
        for _,d in ipairs(workspace:GetDescendants()) do
            if isBarnFind(d.Name) then table.insert(found,d) end
        end
        table.sort(found,function(a,b) return a.Name<b.Name end)
        if #found==0 then
            local empty=Instance.new("TextLabel")
            empty.Size=UDim2.new(1,0,0,20); empty.BackgroundTransparency=1
            empty.Text="BarnFindPart1..20 not found"; empty.TextColor3=Color3.fromRGB(120,120,135)
            empty.Font=Enum.Font.Gotham; empty.TextSize=11; empty.LayoutOrder=1; empty.Parent=barnListHolder
            return
        end
        for i,obj in ipairs(found) do
            local row=Instance.new("TextButton")
            row.Size=UDim2.new(1,0,0,26); row.BackgroundColor3=Color3.fromRGB(34,34,42)
            row.BorderSizePixel=0; row.Text=""; row.AutoButtonColor=false
            row.LayoutOrder=i; row.Parent=barnListHolder
            Instance.new("UICorner",row).CornerRadius=UDim.new(0,4)
            local lbl=Instance.new("TextLabel")
            lbl.Size=UDim2.new(1,-12,1,0); lbl.Position=UDim2.fromOffset(10,0)
            lbl.BackgroundTransparency=1; lbl.Text=obj.Name
            lbl.TextColor3=Color3.fromRGB(210,210,220); lbl.Font=Enum.Font.Gotham
            lbl.TextSize=12; lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.Parent=row
            row.MouseEnter:Connect(function() row.BackgroundColor3=Color3.fromRGB(48,48,60) end)
            row.MouseLeave:Connect(function() row.BackgroundColor3=Color3.fromRGB(34,34,42) end)
            row.MouseButton1Click:Connect(function()
                local pos=getPosition(obj)
                if pos then teleportTo(pos); notifyGlobal("TP",obj.Name,Color3.fromRGB(80,200,120)) end
            end)
        end
    end
    createInteractive(barnSection.content,{
        Text="ESP on BarnFindPart", Desc="Highlight all", Type="toggle", Order=2,
        OnToggle=function(state)
            clearEspFor("barn"); if not state then return end
            for _,d in ipairs(workspace:GetDescendants()) do
                if isBarnFind(d.Name) then
                    local h2=createEspForObject(d,"barn",Color3.fromRGB(255,200,60))
