    sidebar.Size=UDim2.new(0,165,1,-TOPBAR_HEIGHT); sidebar.Position=UDim2.fromOffset(0,TOPBAR_HEIGHT)
    sidebar.BackgroundColor3=Color3.fromRGB(0,0,0); sidebar.BackgroundTransparency=0.35; sidebar.BorderSizePixel=0; sidebar.Parent=window

    local sidebarLine=Instance.new("Frame")
    sidebarLine.Size=UDim2.new(0,1,1,0); sidebarLine.Position=UDim2.new(1,-1,0,0); sidebarLine.BackgroundColor3=Color3.fromRGB(35,35,40); sidebarLine.BorderSizePixel=0; sidebarLine.Parent=sidebar

    local logoArea=Instance.new("Frame")
    logoArea.Size=UDim2.new(1,0,0,60); logoArea.BackgroundTransparency=1; logoArea.Parent=sidebar
    local logoImg=Instance.new("ImageLabel")
    logoImg.Size=UDim2.fromOffset(26,26); logoImg.Position=UDim2.new(0,14,0.5,-13); logoImg.BackgroundTransparency=1
    logoImg.Image="rbxassetid://77128719632427"; logoImg.ScaleType=Enum.ScaleType.Fit; logoImg.Parent=logoArea
    local logoText=Instance.new("TextLabel")
    logoText.Size=UDim2.new(1,-50,1,0); logoText.Position=UDim2.fromOffset(46,0); logoText.BackgroundTransparency=1
    logoText.Text="kotost hub"; logoText.TextColor3=Color3.fromRGB(235,235,245); logoText.Font=Enum.Font.GothamBold; logoText.TextSize=13; logoText.TextXAlignment=Enum.TextXAlignment.Left; logoText.Parent=logoArea

    local logoLine=Instance.new("Frame")
    logoLine.Size=UDim2.new(1,-24,0,1); logoLine.Position=UDim2.fromOffset(12,60); logoLine.BackgroundColor3=Color3.fromRGB(35,35,40); logoLine.BorderSizePixel=0; logoLine.Parent=sidebar

    local tabsContainer=Instance.new("ScrollingFrame")
    tabsContainer.Size=UDim2.new(1,0,1,-61); tabsContainer.Position=UDim2.fromOffset(0,61); tabsContainer.BackgroundTransparency=1
    tabsContainer.BorderSizePixel=0; tabsContainer.ScrollBarThickness=0; tabsContainer.CanvasSize=UDim2.new(0,0,0,0); tabsContainer.AutomaticCanvasSize=Enum.AutomaticSize.Y; tabsContainer.Parent=sidebar

    local tabsLayout=Instance.new("UIListLayout",tabsContainer); tabsLayout.Padding=UDim.new(0,0); tabsLayout.SortOrder=Enum.SortOrder.LayoutOrder

    local content=Instance.new("Frame")
    content.Size=UDim2.new(1,-166,1,-TOPBAR_HEIGHT); content.Position=UDim2.fromOffset(166,TOPBAR_HEIGHT); content.BackgroundTransparency=1; content.Parent=window

    local contentInner=Instance.new("Frame")
    contentInner.Size=UDim2.new(1,-32,1,-32); contentInner.Position=UDim2.fromOffset(16,16); contentInner.BackgroundTransparency=1; contentInner.Parent=content

    -- Drag
    do
        local dragging = false; local dragStart = nil; local startAbsPos = nil
        local function clampPos(x, y)
            local vp = getViewport(); local wS = window.AbsoluteSize
            local maxX = math.max(0, vp.X - wS.X); local maxY = math.max(0, vp.Y - wS.Y)
            return math.clamp(x, 0, maxX), math.clamp(y, 0, maxY)
        end
        local function commitPos(absX, absY)
            local cx, cy = clampPos(absX, absY); window.AnchorPoint = Vector2.new(0, 0); window.Position = UDim2.fromOffset(cx, cy)
        end
        topbar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true; dragStart = input.Position; startAbsPos = window.AbsolutePosition
                input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if not dragging then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                local d = input.Position - dragStart; commitPos(startAbsPos.X + d.X, startAbsPos.Y + d.Y)
            end
        end)
    end

    -- Tabs Logic
    local tabs={}; local currentTab=nil; local tabButtons={}
    local function selectTab(name)
        if not tabs[name] then return end
        for n,btn in pairs(tabButtons) do
            if n==name then btn.bg.BackgroundColor3=Color3.fromRGB(30,30,35); btn.accent.Visible=true; btn.label.TextColor3=Color3.fromRGB(255,255,255)
            else btn.bg.BackgroundColor3=Color3.fromRGB(0,0,0); btn.accent.Visible=false; btn.label.TextColor3=Color3.fromRGB(150,150,160) end
        end
        for _,f in pairs(tabs) do f.Visible=false end
        tabs[name].Visible=true; currentTab=name
    end

    local function addTab(name,labelText,order)
        local cf=Instance.new("Frame"); cf.Size=UDim2.fromScale(1,1); cf.BackgroundTransparency=1; cf.Visible=false; cf.Parent=contentInner; tabs[name]=cf
        local tabBg=Instance.new("Frame"); tabBg.Size=UDim2.new(1,0,0,34); tabBg.BackgroundColor3=Color3.fromRGB(0,0,0); tabBg.BackgroundTransparency=0.3
        tabBg.BorderSizePixel=0; tabBg.LayoutOrder=order or 0; tabBg.Parent=tabsContainer
        local accent=Instance.new("Frame"); accent.Size=UDim2.new(0,2,1,0); accent.BackgroundColor3=Color3.fromRGB(100,200,255); accent.BorderSizePixel=0; accent.Visible=false; accent.Parent=tabBg
        local label=Instance.new("TextLabel"); label.Size=UDim2.new(1,-24,1,0); label.Position=UDim2.fromOffset(14,0); label.BackgroundTransparency=1
        label.Text=labelText; label.TextColor3=Color3.fromRGB(150,150,160); label.Font=Enum.Font.Gotham; label.TextSize=13; label.TextXAlignment=Enum.TextXAlignment.Left; label.Parent=tabBg
        local btn=Instance.new("TextButton"); btn.Size=UDim2.fromScale(1,1); btn.BackgroundTransparency=1; btn.Text=""; btn.Parent=tabBg
        btn.MouseButton1Click:Connect(function() selectTab(name) end)
        tabButtons[name]={bg=tabBg,accent=accent,label=label}
        return cf
    end

    -- Mini Icon & Close
    local minIcon=Instance.new("Frame")
    minIcon.Size=UDim2.fromOffset(56,56); minIcon.Position=UDim2.fromOffset(120,120); minIcon.BackgroundColor3=Color3.fromRGB(0,0,0); minIcon.BorderSizePixel=0
    minIcon.Visible=false; minIcon.Active=true; minIcon.Parent=gui; Instance.new("UICorner",minIcon).CornerRadius=UDim.new(0,12)
    local minIconImg=Instance.new("ImageLabel"); minIconImg.Size=UDim2.fromScale(1,1); minIconImg.BackgroundTransparency=1
    minIconImg.Image="rbxassetid://77128719632427"; minIconImg.ScaleType=Enum.ScaleType.Fit; minIconImg.Parent=minIcon; Instance.new("UICorner",minIconImg).CornerRadius=UDim.new(0,12)
    local minIconBtn=Instance.new("TextButton"); minIconBtn.Size=UDim2.fromScale(1,1); minIconBtn.BackgroundTransparency=1; minIconBtn.Text=""; minIconBtn.Parent=minIcon
    minIconBtn.MouseButton1Click:Connect(function()
        minIcon.Visible=false; window.Visible=true; window.AnchorPoint=Vector2.new(0.5,0.5); window.Position=UDim2.new(0.5,0,0.5,0)
        windowScale.Scale=0.8; TweenService:Create(windowScale,TweenInfo.new(0.3,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Scale=1}):Play()
    end)

    minimBtn.MouseButton1Click:Connect(function()
        local absPos=window.AbsolutePosition; local absSize=window.AbsoluteSize
        window.AnchorPoint=Vector2.new(0,0); window.Position=UDim2.fromOffset(absPos.X,absPos.Y); window.Size=UDim2.fromOffset(absSize.X,absSize.Y)
        local tw=TweenService:Create(window,TweenInfo.new(0.4,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{Position=UDim2.fromOffset(120,120),Size=UDim2.fromOffset(56,56)})
        tw:Play(); tw.Completed:Wait(); window.Visible=false; window.AnchorPoint=Vector2.new(0.5,0.5); window.Position=UDim2.new(0.5,0,0.5,0)
        local s=computeWindowSize(); window.Size=UDim2.fromOffset(s.X,s.Y); minIcon.Position=UDim2.fromOffset(120,120); minIcon.Visible=true
    end)

    closeBtn.MouseButton1Click:Connect(function()
        if getgenv().__KotostHub and getgenv().__KotostHub.cleanup then pcall(getgenv().__KotostHub.cleanup) end
    end)

    return gui, window, windowScale, addTab, selectTab, tabs, tabButtons, contentInner
end
