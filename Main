    testTitle.TextColor3=Color3.fromRGB(240,240,250); testTitle.Font=Enum.Font.GothamBold
    testTitle.TextSize=14; testTitle.TextXAlignment=Enum.TextXAlignment.Left; testTitle.Parent=rightPanel

    local testLine=Instance.new("Frame")
    testLine.Size=UDim2.new(1,-24,0,1); testLine.Position=UDim2.fromOffset(12,34)
    testLine.BackgroundColor3=Color3.fromRGB(40,40,48); testLine.BorderSizePixel=0; testLine.Parent=rightPanel

    local testScroll=Instance.new("ScrollingFrame")
    testScroll.Size=UDim2.new(1,-20,1,-48); testScroll.Position=UDim2.fromOffset(10,42)
    testScroll.BackgroundTransparency=1; testScroll.BorderSizePixel=0
    testScroll.ScrollBarThickness=4; testScroll.ScrollBarImageColor3=Color3.fromRGB(80,80,95)
    testScroll.CanvasSize=UDim2.new(0,0,0,0); testScroll.AutomaticCanvasSize=Enum.AutomaticSize.Y; testScroll.Parent=rightPanel
    local tp=Instance.new("UIPadding",testScroll); tp.PaddingTop=UDim.new(0,2); tp.PaddingLeft=UDim.new(0,2); tp.PaddingRight=UDim.new(0,2)
    local tl=Instance.new("UIListLayout",testScroll); tl.Padding=UDim.new(0,2); tl.SortOrder=Enum.SortOrder.LayoutOrder

    local TEST_ORDER={"getgenv","gethui","cloneref","protectgui","loadstring","identifyexecutor",
        "setclipboard","toclipboard","setfpscap","writefile","readfile","isfile","isfolder","makefolder",
        "listfiles","delfile","delfolder","appendfile","getcustomasset","hookfunction","hookmetamethod",
        "getnamecallmethod","getrawmetatable","setreadonly","isreadonly","getgc","getnilinstances",
        "getconnections","getinstances","syn_request","http_request","request","httpget_game","httpget_fn",
        "firetouchinterest","fireclickdetector","fireproximityprompt","queue_on_teleport","Drawing",
        "highlight","coregui"}

