local function buildMainTab(addTab)
    local mainTab=addTab("Main","main",2)
    local mainScroll=Instance.new("ScrollingFrame")
    mainScroll.Size=UDim2.fromScale(1,1); mainScroll.BackgroundTransparency=1
    mainScroll.BorderSizePixel=0; mainScroll.ScrollBarThickness=4
    mainScroll.CanvasSize=UDim2.new(0,0,0,0); mainScroll.AutomaticCanvasSize=Enum.AutomaticSize.Y; mainScroll.Parent=mainTab
    local mp=Instance.new("UIPadding",mainScroll); mp.PaddingTop=UDim.new(0,2); mp.PaddingBottom=UDim.new(0,2)
    local ml=Instance.new("UIListLayout",mainScroll); ml.Padding=UDim.new(0,6); ml.SortOrder=Enum.SortOrder.LayoutOrder

    -- === PLAYER ===
    local playerSection = createCollapsible(mainScroll, "Player", 1, false)
    local pToggleFly = createInteractive(playerSection.content, {
        Text="Fly", Desc="WASD + Space/Shift", Type="toggle", Order=1,
        OnToggle=function(state) if state then startFly() else stopFly() end end,
    })
    createNumberField(playerSection.content, {
        Text="Fly speed", Default=65, Min=10, Max=500, Order=2,
        OnChange=function(v) Logic.flySpeed=v end,
    })
    local pToggleInfJump = createInteractive(playerSection.content, {
        Text="Infinite jump", Desc="Repeatable space jump", Type="toggle", Order=3,
        OnToggle=function(state) if state then startInfJump() else stopInfJump() end end,
    })
    createNumberField(playerSection.content, {
        Text="Jump power", Default=50, Min=1, Max=1000, Order=4,
        OnChange=function(v)
            Logic.jumpPower=v
            local hum=getHumanoid()
            if hum then pcall(function() hum.UseJumpPower=true; hum.JumpPower=v end) end
        end,
    })
    createNumberField(playerSection.content, {
        Text="Walk speed", Default=16, Min=1, Max=1000, Order=5,
        OnChange=function(v)
            Logic.walkSpeed=v
            local hum=getHumanoid()
            if hum then pcall(function() hum.WalkSpeed=v end) end
        end,
    })
    local pToggleNoclip = createInteractive(playerSection.content, {
        Text="Noclip", Desc="Walk through walls", Type="toggle", Order=6,
        OnToggle=function(state) if state then startNoclip() else stopNoclip() end end,
    })
    createNumberField(playerSection.content, {
        Text="Spin speed", Default=360, Min=10, Max=5000, Order=7,
        OnChange=function(v) Logic.spinSpeed=v end,
    })
    local pToggleSpin = createInteractive(playerSection.content, {
        Text="Spin", Desc="Rotate character", Type="toggle", Order=8,
        OnToggle=function(state) if state then startSpin() else stopSpin() end end,
    })
    local pToggleAntisit = createInteractive(playerSection.content, {
        Text="Antisit", Desc="Prevent sitting", Type="toggle", Order=9,
        OnToggle=function(state) if state then startAntisit() else stopAntisit() end end,
    })

    State.mainToggles.fly=pToggleFly
    State.mainToggles.infJump=pToggleInfJump
    State.mainToggles.noclip=pToggleNoclip
    State.mainToggles.spin=pToggleSpin
    State.mainToggles.antisit=pToggleAntisit

    LocalPlayer.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        local hum=char:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function()
                hum.WalkSpeed=Logic.walkSpeed
                hum.UseJumpPower=true
                hum.JumpPower=Logic.jumpPower
            end)
        end
    end)

    -- === PLAYER TELEPORTS ===
    local ptSection = createCollapsible(mainScroll, "PlayerTeleports", 2, false)
    local ptListHolder = Instance.new("Frame")
    ptListHolder.Size=UDim2.new(1,0,0,0); ptListHolder.AutomaticSize=Enum.AutomaticSize.Y
    ptListHolder.BackgroundColor3=Color3.fromRGB(20,20,24); ptListHolder.BorderSizePixel=0
    ptListHolder.LayoutOrder=1; ptListHolder.Parent=ptSection.content
    Instance.new("UICorner",ptListHolder).CornerRadius=UDim.new(0,4)
    local ptl=Instance.new("UIListLayout",ptListHolder)
    ptl.Padding=UDim.new(0,2); ptl.SortOrder=Enum.SortOrder.LayoutOrder
    local ptp=Instance.new("UIPadding",ptListHolder)
    ptp.PaddingTop=UDim.new(0,4); ptp.PaddingBottom=UDim.new(0,4)
    ptp.PaddingLeft=UDim.new(0,4); ptp.PaddingRight=UDim.new(0,4)

    local function refreshPlayerTeleports()
        for _,c in ipairs(ptListHolder:GetChildren()) do
            if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then c:Destroy() end
        end
        local myHrp = getHRP()
        local list = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local dist = myHrp and (hrp.Position - myHrp.Position).Magnitude or 0
                    table.insert(list, {player=plr, hrp=hrp, dist=dist})
                end
            end
        end
        table.sort(list, function(a,b) return a.dist < b.dist end)

        if #list == 0 then
            local empty=Instance.new("TextLabel")
            empty.Size=UDim2.new(1,0,0,20); empty.BackgroundTransparency=1
            empty.Text="No other players"; empty.TextColor3=Color3.fromRGB(120,120,135)
            empty.Font=Enum.Font.Gotham; empty.TextSize=11; empty.LayoutOrder=1; empty.Parent=ptListHolder
            return
        end

        for i, info in ipairs(list) do
            local row=Instance.new("TextButton")
            row.Size=UDim2.new(1,0,0,30); row.BackgroundColor3=Color3.fromRGB(34,34,42)
            row.BorderSizePixel=0; row.Text=""; row.AutoButtonColor=false
            row.LayoutOrder=i; row.Parent=ptListHolder
            Instance.new("UICorner",row).CornerRadius=UDim.new(0,4)

            local lbl=Instance.new("TextLabel")
            lbl.Size=UDim2.new(1,-80,1,0); lbl.Position=UDim2.fromOffset(10,0)
            lbl.BackgroundTransparency=1
            lbl.Text=info.player.DisplayName.." (@"..info.player.Name..")"
            lbl.TextColor3=Color3.fromRGB(210,210,220); lbl.Font=Enum.Font.Gotham
            lbl.TextSize=12; lbl.TextXAlignment=Enum.TextXAlignment.Left
            lbl.TextTruncate=Enum.TextTruncate.AtEnd; lbl.Parent=row

            local distLbl=Instance.new("TextLabel")
            distLbl.Size=UDim2.new(0,60,1,0); distLbl.Position=UDim2.new(1,-68,0,0)
            distLbl.BackgroundTransparency=1; distLbl.Text=string.format("%d studs", math.floor(info.dist))
            distLbl.TextColor3=Color3.fromRGB(150,150,165); distLbl.Font=Enum.Font.Gotham
            distLbl.TextSize=11; distLbl.TextXAlignment=Enum.TextXAlignment.Right; distLbl.Parent=row

            row.MouseEnter:Connect(function() row.BackgroundColor3=Color3.fromRGB(48,48,60) end)
            row.MouseLeave:Connect(function() row.BackgroundColor3=Color3.fromRGB(34,34,42) end)
            row.MouseButton1Click:Connect(function()
                local hrp = info.player.Character and info.player.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    teleportTo(hrp.Position)
                    notifyGlobal("TP", info.player.DisplayName, Color3.fromRGB(80,200,120))
                end
            end)
        end
    end

    refreshPlayerTeleports()
    task.spawn(function()
        while State.running do
            task.wait(5)
            if ptSection.holder.Parent then refreshPlayerTeleports() end
        end
    end)

    -- === CAR ===
    local carSection = createCollapsible(mainScroll, "Car", 3, false)
    local carSpeedToggle = createInteractive(carSection.content, {
        Text="Speed swap", Desc="W + faster accel", Type="toggle", Order=1,
        OnToggle=function(state)
            if state then startCarSpeed() else stopCarSpeed() end
            if State.mobileDriveHolder then
                if state or (State.mainToggles.carFly and State.mainToggles.carFly.getActive()) then
                    State.mobileDriveHolder.Visible = true
                else
                    State.mobileDriveHolder.Visible = false
                end
            end
        end,
    })
    createNumberField(carSection.content, {
        Text="Max speed", Default=999, Min=50, Max=10000, Order=2,
        OnChange=function(v) Logic.carSpeedMax=v end,
    })
    local carFlyToggle = createInteractive(carSection.content, {
        Text="Car fly", Desc="WASD + Space/Ctrl (leveled)", Type="toggle", Order=3,
        OnToggle=function(state)
            if state then startCarFly() else stopCarFly() end
            if State.mobileDriveHolder then
                if state or (State.mainToggles.carSpeed and State.mainToggles.carSpeed.getActive()) then
                    State.mobileDriveHolder.Visible = true
                else
                    State.mobileDriveHolder.Visible = false
                end
            end
        end,
    })
    createNumberField(carSection.content, {
        Text="Fly speed", Default=80, Min=20, Max=1000, Order=4,
        OnChange=function(v) Logic.carFlySpeed=v end,
    })
    local carFlyHoverToggle = createInteractive(carSection.content, {
        Text="Hover mode", Desc="Hold altitude (Ctrl descends)", Type="toggle", Order=5,
        OnToggle=function(state) Logic.carFlyHover = state end,
    })
    local carNoclipToggle = createInteractive(carSection.content, {
        Text="Car noclip", Desc="Pass through walls", Type="toggle", Order=6,
        OnToggle=function(state) if state then startCarNoclip() else stopCarNoclip() end end,
    })
    local carFarmToggle = createInteractive(carSection.content, {
        Text="Auto farm (loop)", Desc="Drive forward on track", Type="toggle", Order=7,
        OnToggle=function(state)
            if state then
                if not getVehicle() then
                    notifyGlobal("Car","Get in a car first",Color3.fromRGB(200,80,80))
                    carFarmToggle.setActive(false); return
                end
                startCarFarm()
            else stopCarFarm() end
        end,
    })
    createNumberField(carSection.content, {
        Text="Farm speed", Default=320, Min=50, Max=1000, Order=8,
        OnChange=function(v) Logic.carFarmSpeed=v end,
    })
    local carFastStopToggle = createInteractive(carSection.content, {
        Text="Fast stop", Desc="Brake = instant stop (S)", Type="toggle", Order=9,
        OnToggle=function(state)
            Logic.carFastStop = state
            if state then startCarFastStop() else stopCarFastStop() end
        end,
    })
    local carLaunchStartToggle = createInteractive(carSection.content, {
        Text="Launch start", Desc="W = instant max speed", Type="toggle", Order=10,
        OnToggle=function(state)
            Logic.carLaunchStart = state
            if state then startCarLaunchStart() else stopCarLaunchStart() end
        end,
    })

    -- Mesh swap
    local meshRow = Instance.new("Frame")
    meshRow.Size = UDim2.new(1,0,0,30); meshRow.BackgroundColor3 = Color3.fromRGB(34,34,42)
    meshRow.BorderSizePixel = 0; meshRow.LayoutOrder = 11; meshRow.Parent = carSection.content
    Instance.new("UICorner",meshRow).CornerRadius = UDim.new(0,6)
    local meshLbl = Instance.new("TextLabel")
    meshLbl.Size = UDim2.new(0.4,0,1,0); meshLbl.Position = UDim2.fromOffset(10,0)
    meshLbl.BackgroundTransparency = 1; meshLbl.Text = "Mesh swap"
    meshLbl.TextColor3 = Color3.fromRGB(220,220,230); meshLbl.Font = Enum.Font.GothamMedium; meshLbl.TextSize = 13
    meshLbl.TextXAlignment = Enum.TextXAlignment.Left; meshLbl.Parent = meshRow
    local meshInput = Instance.new("TextBox")
    meshInput.Size = UDim2.new(0.6,-40,1,-6); meshInput.Position = UDim2.new(0.4,-4,0,3)
    meshInput.BackgroundColor3 = Color3.fromRGB(20,20,26); meshInput.BorderSizePixel = 0
    meshInput.PlaceholderText = "rbxassetid://..."; meshInput.Text = ""; meshInput.TextColor3 = Color3.fromRGB(220,220,230)
    meshInput.Font = Enum.Font.Gotham; meshInput.TextSize = 11; meshInput.ClearTextOnFocus = false; meshInput.Parent = meshRow
    Instance.new("UICorner",meshInput).CornerRadius = UDim.new(0,4)

    local meshApplyBtn = Instance.new("TextButton")
    meshApplyBtn.Size = UDim2.new(1,0,0,26); meshApplyBtn.BackgroundColor3 = Color3.fromRGB(80,180,120)
    meshApplyBtn.BorderSizePixel = 0; meshApplyBtn.Text = "Apply mesh"; meshApplyBtn.TextColor3 = Color3.new(1,1,1)
    meshApplyBtn.Font = Enum.Font.GothamBold; meshApplyBtn.TextSize = 12; meshApplyBtn.LayoutOrder = 12
    meshApplyBtn.Parent = carSection.content; Instance.new("UICorner",meshApplyBtn).CornerRadius = UDim.new(0,5)

    local meshRestoreBtn = Instance.new("TextButton")
    meshRestoreBtn.Size = UDim2.new(1,0,0,26); meshRestoreBtn.BackgroundColor3 = Color3.fromRGB(70,70,80)
    meshRestoreBtn.BorderSizePixel = 0; meshRestoreBtn.Text = "Restore original look"; meshRestoreBtn.TextColor3 = Color3.fromRGB(220,220,230)
    meshRestoreBtn.Font = Enum.Font.GothamMedium; meshRestoreBtn.TextSize = 12; meshRestoreBtn.LayoutOrder = 13
    meshRestoreBtn.Parent = carSection.content; Instance.new("UICorner",meshRestoreBtn).CornerRadius = UDim.new(0,5)

    meshApplyBtn.MouseButton1Click:Connect(function()
        local text = tostring(meshInput.Text or "")
        local id = text:match("rbxassetid://(%d+)") or text:match("/asset/(%d+)") or text:match("^%s*(%d+)%s*$")
        id = id and tonumber(id)
        if not id then notifyGlobal("Mesh","Invalid ID",Color3.fromRGB(200,80,80)); return end
        if not getVehicle() then notifyGlobal("Mesh","Get in a car first",Color3.fromRGB(200,80,80)); return end
        notifyGlobal("Mesh","Loading "..id.."...",Color3.fromRGB(100,200,255))
        applyMeshSwap(id)
    end)
    meshRestoreBtn.MouseButton1Click:Connect(function()
        if not getVehicle() then notifyGlobal("Mesh","Get in a car first",Color3.fromRGB(200,80,80)); return end
        restoreMesh()
        notifyGlobal("Mesh","Restored",Color3.fromRGB(80,200,120))
    end)

    State.mainToggles.carSpeed=carSpeedToggle
    State.mainToggles.carFly=carFlyToggle
    State.mainToggles.carFlyHover=carFlyHoverToggle
    State.mainToggles.carNoclip=carNoclipToggle
    State.mainToggles.carFarm=carFarmToggle
    State.mainToggles.carFastStop=carFastStopToggle
    State.mainToggles.carLaunchStart=carLaunchStartToggle

    -- === AUTOFARM ===
    local autofarmSection = createCollapsible(mainScroll, "AutoFarm", 4, false)
    local autoDrivingToggle = createInteractive(autofarmSection.content, {
        Text="Auto driving", Desc="Loop A <-> B without speed loss", Type="toggle", Order=1,
        OnToggle=function(state)
            if state then
                if not getVehicle() then
                    notifyGlobal("AutoFarm","Get in a car first",Color3.fromRGB(200,80,80))
                    autoDrivingToggle.setActive(false); return
                end
                notifyGlobal("AutoFarm","Teleporting to A...",Color3.fromRGB(100,200,255))
                startAutoDrive()
            else
                stopAutoDrive()
                notifyGlobal("AutoFarm","Stopped",Color3.fromRGB(240,200,60))
            end
        end,
    })
    createNumberField(autofarmSection.content, {
        Text="Drive speed", Default=300, Min=50, Max=1000, Order=2,
        OnChange=function(v) Logic.autoDriveSpeed=v end,
    })
    State.mainToggles.autoDriving = autoDrivingToggle
end
local function buildVisualsTab(addTab)
    local visualsTab=addTab("Visuals","visuals",3)
    local visualsScroll=Instance.new("ScrollingFrame")
    visualsScroll.Size=UDim2.fromScale(1,1); visualsScroll.BackgroundTransparency=1
    visualsScroll.BorderSizePixel=0; visualsScroll.ScrollBarThickness=4
    visualsScroll.CanvasSize=UDim2.new(0,0,0,0); visualsScroll.AutomaticCanvasSize=Enum.AutomaticSize.Y
    visualsScroll.Parent=visualsTab
    local vp2=Instance.new("UIPadding",visualsScroll)
    vp2.PaddingTop=UDim.new(0,2); vp2.PaddingBottom=UDim.new(0,2)
    local vl=Instance.new("UIListLayout",visualsScroll)
    vl.Padding=UDim.new(0,6); vl.SortOrder=Enum.SortOrder.LayoutOrder

    -- 1. Fullbright
    local fbData={active=false,save={}}
    createInteractive(visualsScroll,{
        Text="Fullbright", Desc="Max world brightness", Type="toggle", Order=1,
        OnToggle=function(state)
            if state then
                fbData.save.brightness=Lighting.Brightness
                fbData.save.ambient=Lighting.Ambient
                fbData.save.outdoor=Lighting.OutdoorAmbient
                fbData.save.shadows=Lighting.GlobalShadows
                fbData.save.clock=Lighting.ClockTime
                Lighting.Brightness=3
                Lighting.Ambient=Color3.fromRGB(255,255,255)
                Lighting.OutdoorAmbient=Color3.fromRGB(255,255,255)
                Lighting.GlobalShadows=false
                Lighting.ClockTime=12
                fbData.active=true
            else
                if fbData.save.brightness~=nil then
                    Lighting.Brightness=fbData.save.brightness
                    Lighting.Ambient=fbData.save.ambient
                    Lighting.OutdoorAmbient=fbData.save.outdoor
                    Lighting.GlobalShadows=fbData.save.shadows
                    Lighting.ClockTime=fbData.save.clock
                end
                fbData.active=false
            end
        end,
    })

    -- 2. NoFog
    local nfData={active=false,atmoStates={},saveFogEnd=nil,saveFogStart=nil}
    createInteractive(visualsScroll,{
        Text="NoFog", Desc="Remove fog and atmosphere", Type="toggle", Order=2,
        OnToggle=function(state)
            if state then
                nfData.saveFogEnd=Lighting.FogEnd
                nfData.saveFogStart=Lighting.FogStart
                pcall(function()
                    Lighting.FogEnd=100000000
                    Lighting.FogStart=100000000
                end)
                for _,d in ipairs(Lighting:GetDescendants()) do
                    if d:IsA("Atmosphere") then
                        nfData.atmoStates[d]={Density=d.Density,Haze=d.Haze}
                        d.Density=0; d.Haze=0
                    end
                end
                nfData.active=true
            else
                if nfData.saveFogEnd then
                    pcall(function()
                        Lighting.FogEnd=nfData.saveFogEnd
                        Lighting.FogStart=nfData.saveFogStart
                    end)
                end
                for atm,s in pairs(nfData.atmoStates) do
                    if atm and atm.Parent then atm.Density=s.Density; atm.Haze=s.Haze end
                end
                nfData.atmoStates={}; nfData.active=false
            end
        end,
    })

    -- 3. ESP Players
    local espPlrData={active=false,entries={},conns={},distLoop=nil}
    local function destroyPlayerEspEntry(entry)
        if not entry then return end
        if entry.highlight then pcall(function() entry.highlight:Destroy() end) end
        if entry.billboard then pcall(function() entry.billboard:Destroy() end) end
        for _,c in ipairs(entry.conns or {}) do pcall(function() c:Disconnect() end) end
        entry.conns={}; entry.highlight=nil; entry.billboard=nil
        entry.nameLabel=nil; entry.hpBar=nil; entry.distLabel=nil
    end
    local function createPlayerEspEntry(player)
        if player==LocalPlayer then return nil end
        local entry={conns={}}
        local function buildForCharacter(char)
            if not char then return end
            local hrp=char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart",3)
            local hum=char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid",3)
            if not hrp or not hum then return end
            local hl2=Instance.new("Highlight")
            hl2.Adornee=char; hl2.FillColor=Color3.fromRGB(255,100,100)
            hl2.OutlineColor=Color3.fromRGB(255,100,100)
            hl2.FillTransparency=0.5; hl2.OutlineTransparency=0
            hl2.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
            hl2.Parent=char; entry.highlight=hl2
            
            local bb=Instance.new("BillboardGui")
            bb.Size=UDim2.new(0,130,0,52); bb.StudsOffset=Vector3.new(0,3.2,0)
            bb.AlwaysOnTop=true; bb.LightInfluence=0; bb.Adornee=hrp; bb.Parent=hrp
            entry.billboard=bb
            
            local nameLbl2=Instance.new("TextLabel")
            nameLbl2.Size=UDim2.new(1,0,0,16); nameLbl2.BackgroundTransparency=1
            nameLbl2.Text=player.DisplayName.." (@"..player.Name..")"
            nameLbl2.TextColor3=Color3.fromRGB(255,255,255)
            nameLbl2.TextStrokeTransparency=0
            nameLbl2.Font=Enum.Font.GothamBold; nameLbl2.TextSize=11
            nameLbl2.Parent=bb; entry.nameLabel=nameLbl2
            
            local hpBg=Instance.new("Frame")
            hpBg.Size=UDim2.new(1,0,0,6); hpBg.Position=UDim2.new(0,0,0,17)
            hpBg.BackgroundColor3=Color3.fromRGB(30,30,35); hpBg.BorderSizePixel=0
            hpBg.Parent=bb
            Instance.new("UICorner",hpBg).CornerRadius=UDim.new(0,3)
            
            local hpBar=Instance.new("Frame")
            hpBar.Size=UDim2.new(1,0,1,0)
            hpBar.BackgroundColor3=Color3.fromRGB(80,200,120)
            hpBar.BorderSizePixel=0; hpBar.Parent=hpBg
            Instance.new("UICorner",hpBar).CornerRadius=UDim.new(0,3)
            entry.hpBar=hpBar
            
            local distLbl=Instance.new("TextLabel")
            distLbl.Size=UDim2.new(1,0,0,14); distLbl.Position=UDim2.new(0,0,0,26)
            distLbl.BackgroundTransparency=1; distLbl.Text="..."
            distLbl.TextColor3=Color3.fromRGB(220,220,220)
            distLbl.TextStrokeTransparency=0
            distLbl.Font=Enum.Font.Gotham; distLbl.TextSize=10
            distLbl.Parent=bb; entry.distLabel=distLbl
            
            local function updateHp()
                local hp=hum.Health; local maxHp=hum.MaxHealth
                if maxHp and maxHp>0 then
                    local pct=math.clamp(hp/maxHp,0,1)
                    hpBar.Size=UDim2.new(pct,0,1,0)
                    hpBar.BackgroundColor3=Color3.fromRGB(220,80,80):Lerp(Color3.fromRGB(80,200,120),pct)
                end
            end
            updateHp()
            table.insert(entry.conns,hum.HealthChanged:Connect(updateHp))
            table.insert(entry.conns,hum:GetPropertyChangedSignal("MaxHealth"):Connect(updateHp))
        end
        local function cleanupCharacter()
            if entry.highlight then pcall(function() entry.highlight:Destroy() end); entry.highlight=nil end
            if entry.billboard then pcall(function() entry.billboard:Destroy() end); entry.billboard=nil end
            entry.nameLabel=nil; entry.hpBar=nil; entry.distLabel=nil
            for _,c in ipairs(entry.conns or {}) do pcall(function() c:Disconnect() end) end
            entry.conns={}
        end
        if player.Character then buildForCharacter(player.Character) end
        table.insert(entry.conns,player.CharacterAdded:Connect(function(char)
            cleanupCharacter(); buildForCharacter(char)
        end))
        table.insert(entry.conns,player.CharacterRemoving:Connect(cleanupCharacter))
        return entry
    end
    local function stopPlayerEsp()
        if espPlrData.distLoop then pcall(function() espPlrData.distLoop:Disconnect() end); espPlrData.distLoop=nil end
        for _,c in ipairs(espPlrData.conns or {}) do pcall(function() c:Disconnect() end) end
        espPlrData.conns={}
        for plr,entry in pairs(espPlrData.entries) do destroyPlayerEspEntry(entry) end
        espPlrData.entries={}; espPlrData.active=false
    end
    local function startPlayerEsp()
        stopPlayerEsp(); espPlrData.active=true
        local function addPlayer(plr)
            if plr==LocalPlayer then return end
            if espPlrData.entries[plr] then return end
            local e=createPlayerEspEntry(plr)
            if e then espPlrData.entries[plr]=e end
        end
        for _,plr in ipairs(Players:GetPlayers()) do addPlayer(plr) end
        table.insert(espPlrData.conns,Players.PlayerAdded:Connect(function(plr)
            if espPlrData.active then addPlayer(plr) end
        end))
        table.insert(espPlrData.conns,Players.PlayerRemoving:Connect(function(plr)
            local e=espPlrData.entries[plr]
            if e then destroyPlayerEspEntry(e); espPlrData.entries[plr]=nil end
        end))
        espPlrData.distLoop=RunService.Heartbeat:Connect(function()
            local myHrp=getHRP(); if not myHrp then return end
            for _,entry in pairs(espPlrData.entries) do
                if entry.distLabel and entry.billboard and entry.billboard.Adornee then
                    local ad=entry.billboard.Adornee
                    if ad.Parent then
                        local d=(ad.Position-myHrp.Position).Magnitude
                        entry.distLabel.Text=string.format("[%d studs]",math.floor(d))
                    end
                end
            end
        end)
    end
    createInteractive(visualsScroll,{
        Text="ESP Players", Desc="Name, HP bar, distance", Type="toggle", Order=3,
        OnToggle=function(state) if state then startPlayerEsp() else stopPlayerEsp() end end,
    })

    -- 4. Shaders
    local shaderData={active=false,effects={}}
    createInteractive(visualsScroll,{
        Text="Shaders", Desc="Bloom + CC + SunRays", Type="toggle", Order=4,
        OnToggle=function(state)
            if state then
                if shaderData.active then return end
                local cc=Instance.new("ColorCorrectionEffect")
                cc.Brightness=0.05; cc.Contrast=0.12; cc.Saturation=0.25
                cc.TintColor=Color3.fromRGB(255,245,235); cc.Parent=Lighting
                table.insert(shaderData.effects,cc)
                local bloom=Instance.new("BloomEffect")
                bloom.Intensity=0.5; bloom.Size=24; bloom.Threshold=0.85
                bloom.Parent=Lighting; table.insert(shaderData.effects,bloom)
                local rays=Instance.new("SunRaysEffect")
                rays.Intensity=0.05; rays.Spread=0.8
                rays.Parent=Lighting; table.insert(shaderData.effects,rays)
                shaderData.active=true
            else
                for _,e in ipairs(shaderData.effects) do pcall(function() e:Destroy() end) end
                shaderData.effects={}; shaderData.active=false
            end
        end,
    })

    -- 5. FPS Boost
    local fpsBoostData={active=false, disabled={}, saved={}}
    local function restoreFpsBoost()
        if fpsBoostData.saved.globalShadows~=nil then
            pcall(function() Lighting.GlobalShadows=fpsBoostData.saved.globalShadows end)
        end
        if fpsBoostData.saved.shadowSoftness~=nil then
            pcall(function() Lighting.ShadowSoftness=fpsBoostData.saved.shadowSoftness end)
        end
        for _,entry in ipairs(fpsBoostData.disabled) do
            local obj=entry.obj
            if obj and obj.Parent then pcall(function() obj[entry.prop]=entry.old end) end
        end
        fpsBoostData.disabled={}; fpsBoostData.active=false
    end
    createInteractive(visualsScroll,{
        Text="FPS Boost", Desc="Shadows/effects off", Type="toggle", Order=5,
        OnToggle=function(state)
            if state then
                if fpsBoostData.active then return end
                fpsBoostData.active=true
                fpsBoostData.saved.globalShadows=Lighting.GlobalShadows
                pcall(function() Lighting.GlobalShadows=false end)
                pcall(function()
                    fpsBoostData.saved.shadowSoftness=Lighting.ShadowSoftness
                    Lighting.ShadowSoftness=0
                end)
                for _,obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("ParticleEmitter") or obj:IsA("Beam") or obj:IsA("Trail")
                    or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
                        if obj.Enabled then
                            table.insert(fpsBoostData.disabled,{obj=obj,prop="Enabled",old=true})
                            pcall(function() obj.Enabled=false end)
                        end
                    elseif obj:IsA("BasePart") then
                        if obj.CastShadow then
                            table.insert(fpsBoostData.disabled,{obj=obj,prop="CastShadow",old=true})
                            pcall(function() obj.CastShadow=false end)
                        end
                    end
                end
                notifyGlobal("Visuals","FPS Boost ON",Color3.fromRGB(80,200,120))
            else
                restoreFpsBoost()
                notifyGlobal("Visuals","FPS Boost OFF",Color3.fromRGB(240,200,60))
            end
        end,
    })

    -- 6. SpeedCameras
    local camSection = createCollapsible(visualsScroll, "SpeedCameras", 6, false)
    local camListHolder = Instance.new("Frame")
    camListHolder.Size=UDim2.new(1,0,0,0); camListHolder.AutomaticSize=Enum.AutomaticSize.Y
    camListHolder.BackgroundColor3=Color3.fromRGB(20,20,24); camListHolder.BorderSizePixel=0
    camListHolder.LayoutOrder=2; camListHolder.Parent=camSection.content
    Instance.new("UICorner",camListHolder).CornerRadius=UDim.new(0,4)
    local cml=Instance.new("UIListLayout",camListHolder)
    cml.Padding=UDim.new(0,2); cml.SortOrder=Enum.SortOrder.LayoutOrder
    local cmp=Instance.new("UIPadding",camListHolder)
    cmp.PaddingTop=UDim.new(0,4); cmp.PaddingBottom=UDim.new(0,4)
    cmp.PaddingLeft=UDim.new(0,4); cmp.PaddingRight=UDim.new(0,4)

    State.espHandles["speedcams"] = { highlights = {}, conns = {} }
    local function getSpeedCamFolder() return workspace:FindFirstChild("SpeedCameras") end
    local function refreshSpeedCamList()
        for _,c in ipairs(camListHolder:GetChildren()) do
            if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then c:Destroy() end
        end
        local folder = getSpeedCamFolder()
        if not folder then
            local empty=Instance.new("TextLabel")
            empty.Size=UDim2.new(1,0,0,20); empty.BackgroundTransparency=1
            empty.Text="SpeedCameras folder not found"; empty.TextColor3=Color3.fromRGB(120,120,135)
            empty.Font=Enum.Font.Gotham; empty.TextSize=11; empty.LayoutOrder=1; empty.Parent=camListHolder
            return
        end
        local list = {}
        for _,c in ipairs(folder:GetChildren()) do
            if c:IsA("Model") or c:IsA("BasePart") then table.insert(list, c) end
        end
        table.sort(list, function(a,b) return a.Name < b.Name end)
        if #list == 0 then
            local empty=Instance.new("TextLabel")
            empty.Size=UDim2.new(1,0,0,20); empty.BackgroundTransparency=1
            empty.Text="No cameras in folder"; empty.TextColor3=Color3.fromRGB(120,120,135)
            empty.Font=Enum.Font.Gotham; empty.TextSize=11; empty.LayoutOrder=1; empty.Parent=camListHolder
            return
        end
        for i, obj in ipairs(list) do
            local row=Instance.new("TextButton")
            row.Size=UDim2.new(1,0,0,26); row.BackgroundColor3=Color3.fromRGB(34,34,42)
            row.BorderSizePixel=0; row.Text=""; row.AutoButtonColor=false
            row.LayoutOrder=i; row.Parent=camListHolder
            Instance.new("UICorner",row).CornerRadius=UDim.new(0,4)
            local lbl=Instance.new("TextLabel")
            lbl.Size=UDim2.new(1,-12,1,0); lbl.Position=UDim2.fromOffset(10,0)
            lbl.BackgroundTransparency=1; lbl.Text=obj.Name
            lbl.TextColor3=Color3.fromRGB(210,210,220); lbl.Font=Enum.Font.Gotham
            lbl.TextSize=12; lbl.TextXAlignment=Enum.TextXAlignment.Left
            lbl.TextTruncate=Enum.TextTruncate.AtEnd; lbl.Parent=row
            row.MouseEnter:Connect(function() row.BackgroundColor3=Color3.fromRGB(48,48,60) end)
            row.MouseLeave:Connect(function() row.BackgroundColor3=Color3.fromRGB(34,34,42) end)
            row.MouseButton1Click:Connect(function()
                local pos=getPosition(obj)
                if pos then
                    teleportTo(pos)
                    notifyGlobal("TP", obj.Name, Color3.fromRGB(80,200,120))
                end
            end)
        end
    end
    createInteractive(camSection.content,{
        Text="ESP on speed cameras", Desc="Highlight cameras", Type="toggle", Order=1,
        OnToggle=function(state)
            clearEspFor("speedcams")
            if not state then return end
            local folder = getSpeedCamFolder()
            if not folder then
                notifyGlobal("ESP","SpeedCameras folder not found",Color3.fromRGB(200,80,80)); return
            end
            for _,c in ipairs(folder:GetChildren()) do
                if c:IsA("Model") or c:IsA("BasePart") then
                    local h2=createEspForObject(c,"speedcams",Color3.fromRGB(255,60,60))
                    if h2 then State.espHandles["speedcams"].highlights[c]=h2 end
                end
            end
        end,
    })
    refreshSpeedCamList()
    task.spawn(function()
        while State.running do
            task.wait(5)
            if camSection.holder.Parent then refreshSpeedCamList() end
        end
    end)

    -- 7. HUD
    local hudData={active=false,gui=nil,conn=nil,fpsCounter=0,fpsTime=0}
    local function stopHud()
        if hudData.conn then pcall(function() hudData.conn:Disconnect() end); hudData.conn=nil end
        if hudData.gui then pcall(function() hudData.gui:Destroy() end); hudData.gui=nil end
        hudData.active=false
    end
    local function startHud()
        if hudData.active then return end
        hudData.active=true; hudData.fpsCounter=0; hudData.fpsTime=0
        local guiH=Instance.new("ScreenGui")
        guiH.Name="KotostHUD_"..tostring(math.random(1,1e6))
        guiH.ResetOnSpawn=false; guiH.IgnoreGuiInset=true
        guiH.DisplayOrder=999998; guiH.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
        if CAPS.protectgui then pcall(protectgui,guiH) end
        local okH=pcall(function() guiH.Parent=GuiParent end)
        if not okH or not guiH.Parent then guiH.Parent=PlayerGui end
        hudData.gui=guiH
        local bar=Instance.new("Frame")
        bar.Size=UDim2.fromOffset(500,30); bar.AnchorPoint=Vector2.new(0.5,1)
        bar.Position=UDim2.new(0.5,0,1,-60); bar.BackgroundColor3=Color3.fromRGB(0,0,0)
        bar.BackgroundTransparency=0.45; bar.BorderSizePixel=0; bar.Parent=guiH
        Instance.new("UICorner",bar).CornerRadius=UDim.new(0,8)
        local stroke=Instance.new("UIStroke",bar)
        stroke.Color=Color3.fromRGB(60,60,70); stroke.Thickness=1
        local logo=Instance.new("ImageLabel")
        logo.Size=UDim2.fromOffset(20,20); logo.Position=UDim2.fromOffset(8,5)
        logo.BackgroundTransparency=1; logo.Image="rbxassetid://77128719632427"
        logo.ScaleType=Enum.ScaleType.Fit; logo.Parent=bar
        local title=Instance.new("TextLabel")
        title.Size=UDim2.fromOffset(110,30); title.Position=UDim2.fromOffset(34,0)
        title.BackgroundTransparency=1; title.Text="kotost games hub"
        title.TextColor3=Color3.fromRGB(220,220,235)
        title.Font=Enum.Font.GothamBold; title.TextSize=12
        title.TextXAlignment=Enum.TextXAlignment.Left
        title.TextTruncate=Enum.TextTruncate.AtEnd; title.Parent=bar
        local fpsLbl=Instance.new("TextLabel")
        fpsLbl.Size=UDim2.fromOffset(70,30); fpsLbl.Position=UDim2.new(1,-290,0,0)
        fpsLbl.BackgroundTransparency=1; fpsLbl.Text="FPS: -"
        fpsLbl.TextColor3=Color3.fromRGB(180,220,180)
        fpsLbl.Font=Enum.Font.GothamMedium; fpsLbl.TextSize=11
        fpsLbl.TextXAlignment=Enum.TextXAlignment.Left; fpsLbl.Parent=bar
        local pingLbl=Instance.new("TextLabel")
        pingLbl.Size=UDim2.fromOffset(80,30); pingLbl.Position=UDim2.new(1,-210,0,0)
        pingLbl.BackgroundTransparency=1; pingLbl.Text="Ping: -"
        pingLbl.TextColor3=Color3.fromRGB(180,200,235)
        pingLbl.Font=Enum.Font.GothamMedium; pingLbl.TextSize=11
        pingLbl.TextXAlignment=Enum.TextXAlignment.Left; pingLbl.Parent=bar
        local nickLbl=Instance.new("TextLabel")
        nickLbl.Size=UDim2.fromOffset(130,30); nickLbl.Position=UDim2.new(1,-130,0,0)
        nickLbl.BackgroundTransparency=1
        nickLbl.Text=LocalPlayer.DisplayName or LocalPlayer.Name
        nickLbl.TextColor3=Color3.fromRGB(235,235,245)
        nickLbl.Font=Enum.Font.GothamBold; nickLbl.TextSize=11
        nickLbl.TextXAlignment=Enum.TextXAlignment.Right
        nickLbl.TextTruncate=Enum.TextTruncate.AtEnd; nickLbl.Parent=bar
        local padding=Instance.new("UIPadding",nickLbl)
        padding.PaddingRight=UDim.new(0,8)
        hudData.conn=RunService.Heartbeat:Connect(function(dt)
            hudData.fpsCounter=hudData.fpsCounter+1
            hudData.fpsTime=hudData.fpsTime+dt
            if hudData.fpsTime>=1 then
                local fps=math.floor(hudData.fpsCounter/hudData.fpsTime+0.5)
                fpsLbl.Text="FPS: "..tostring(fps)
                hudData.fpsCounter=0; hudData.fpsTime=0
                local p=getPing()
                pingLbl.Text=p>=0 and ("Ping: "..tostring(p).."ms") or "Ping: N/A"
            end
        end)
    end
    createInteractive(visualsScroll,{
        Text="HUD", Desc="Bottom bar: logo, FPS, ping, nick", Type="toggle", Order=7,
        OnToggle=function(state) if state then startHud() else stopHud() end end,
    })

    -- 8. Time Locker
    local timeSection = createCollapsible(visualsScroll, "Time Locker", 8, false)
    local timeToggle = createInteractive(timeSection.content, {
        Text="Freeze Time", Desc="Stops day/night cycle", Type="toggle", Order=1,
        OnToggle=function(state)
            if state then startTimeLocker() else stopTimeLocker() end
        end,
    })
    createNumberField(timeSection.content, {
        Text="Time (0-24)", Default=14, Min=0, Max=24, Order=2,
        OnChange=function(v) Lighting.ClockTime = v end,
    })

    -- Очистка при закрытии
    State.cleanupFns[#State.cleanupFns+1] = function()
        pcall(stopPlayerEsp); pcall(stopHud); pcall(restoreFpsBoost); pcall(stopTimeLocker)
        if shaderData.active then
            for _,e in ipairs(shaderData.effects) do pcall(function() e:Destroy() end) end
        end
        if fbData.active then
            pcall(function()
                Lighting.Brightness=fbData.save.brightness
                Lighting.Ambient=fbData.save.ambient
                Lighting.OutdoorAmbient=fbData.save.outdoor
                Lighting.GlobalShadows=fbData.save.shadows
                Lighting.ClockTime=fbData.save.clock
            end)
        end
        if nfData.active then
            pcall(function()
                Lighting.FogEnd=nfData.saveFogEnd
                Lighting.FogStart=nfData.saveFogStart
            end)
            for atm,s in pairs(nfData.atmoStates) do
                if atm and atm.Parent then atm.Density=s.Density; atm.Haze=s.Haze end
            end
        end
    end
end
local function buildRaceTab(addTab)
    local raceTab = addTab("Race", "race", 4)
    local raceScroll = Instance.new("ScrollingFrame")
    raceScroll.Size = UDim2.fromScale(1,1); raceScroll.BackgroundTransparency = 1
    raceScroll.BorderSizePixel = 0; raceScroll.ScrollBarThickness = 4
    raceScroll.CanvasSize = UDim2.new(0,0,0,0); raceScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    raceScroll.Parent = raceTab
    local rp = Instance.new("UIPadding", raceScroll)
    rp.PaddingTop = UDim.new(0,2); rp.PaddingBottom = UDim.new(0,2)
    local rl = Instance.new("UIListLayout", raceScroll)
    rl.Padding = UDim.new(0,6); rl.SortOrder = Enum.SortOrder.LayoutOrder

    local function makeRaceModeRow(parent, order)
        local holder = Instance.new("Frame")
        holder.Size = UDim2.new(1,0,0,30)
        holder.BackgroundTransparency = 1
        holder.LayoutOrder = order
        holder.Parent = parent

        local mode = "tp"
        local flyBtn = Instance.new("TextButton")
        flyBtn.Size = UDim2.new(0.5,-3,1,0)
        flyBtn.BackgroundColor3 = Color3.fromRGB(50,50,62)
        flyBtn.BorderSizePixel = 0; flyBtn.Text = "Fly"
        flyBtn.TextColor3 = Color3.fromRGB(220,220,230)
        flyBtn.Font = Enum.Font.GothamBold; flyBtn.TextSize = 12
        flyBtn.Parent = holder
        Instance.new("UICorner",flyBtn).CornerRadius = UDim.new(0,5)

        local tpBtn = Instance.new("TextButton")
        tpBtn.Size = UDim2.new(0.5,-3,1,0)
        tpBtn.Position = UDim2.new(0.5,3,0,0)
        tpBtn.BackgroundColor3 = Color3.fromRGB(80,200,120)
        tpBtn.BorderSizePixel = 0; tpBtn.Text = "TP"
        tpBtn.TextColor3 = Color3.fromRGB(15,15,20)
        tpBtn.Font = Enum.Font.GothamBold; tpBtn.TextSize = 12
        tpBtn.Parent = holder
        Instance.new("UICorner",tpBtn).CornerRadius = UDim.new(0,5)

        local function render()
            if mode=="fly" then
                flyBtn.BackgroundColor3=Color3.fromRGB(80,200,120); flyBtn.TextColor3=Color3.fromRGB(15,15,20)
                tpBtn.BackgroundColor3=Color3.fromRGB(50,50,62); tpBtn.TextColor3=Color3.fromRGB(220,220,230)
            else
                tpBtn.BackgroundColor3=Color3.fromRGB(80,200,120); tpBtn.TextColor3=Color3.fromRGB(15,15,20)
                flyBtn.BackgroundColor3=Color3.fromRGB(50,50,62); flyBtn.TextColor3=Color3.fromRGB(220,220,230)
            end
        end
        flyBtn.MouseButton1Click:Connect(function() mode="fly"; render() end)
        tpBtn.MouseButton1Click:Connect(function() mode="tp"; render() end)
        render()
        return { get = function() return mode end }
    end

    local function runRaceLoop(points, modeRef, speedRef, counterLabel, getActive)
        task.spawn(function()
            local lap = 0
            while getActive() do
                lap = lap + 1
                for i, point in ipairs(points) do
                    if not getActive() then break end
                    counterLabel.Text = string.format("Lap: %d | Point: %d/%d", lap, i, #points)
                    if modeRef.get() == "tp" then
                        local target = point + Vector3.new(0, 6, 0)
                        local hrp = getHRP()
                        if hrp then pcall(function() hrp.CFrame = CFrame.new(target) end) end
                        task.wait(3)
                    else
                        local hrp = getHRP()
                        if hrp then
                            local speed = speedRef.value or 120
                            while getActive() do
                                local h2 = getHRP(); if not h2 then break end
                                local diff = point - h2.Position
                                local dist = diff.Magnitude
                                if dist < 3 then break end
                                local step = math.min(speed / 60, dist)
                                pcall(function() h2.CFrame = CFrame.new(h2.Position + diff.Unit * step) end)
                                task.wait()
                            end
                        end
                        task.wait(0.1)
                    end
                end
            end
            counterLabel.Text = "Lap: 0 | Point: 0/0"
        end)
    end

    -- 1. Halloween Race
    local halloweenRace = createCollapsible(raceScroll, "Halloween Race", 1, false)
    local hallMode = makeRaceModeRow(halloweenRace.content, 1)
    local hallSpeedRef = { value = 120 }
    createNumberField(halloweenRace.content, {
        Text = "Fly speed", Default = 120, Min = 20, Max = 500, Order = 2,
        OnChange = function(v) hallSpeedRef.value = v end,
    })
    local HALLOWEEN_POINTS = {
        Vector3.new(-18, 846, -306), Vector3.new(6, 846, -497), Vector3.new(-97, 846, -737),
        Vector3.new(-352, 846, -687), Vector3.new(-662, 799, -1066), Vector3.new(-879, 794, -950),
        Vector3.new(-749, 749, -507), Vector3.new(386, 846, 30), Vector3.new(327, 846, -169),
    }
    local hallCounter = Instance.new("TextLabel")
    hallCounter.Size = UDim2.new(1,0,0,20); hallCounter.BackgroundTransparency = 1
    hallCounter.Text = "Lap: 0 | Point: 0/"..#HALLOWEEN_POINTS
    hallCounter.TextColor3 = Color3.fromRGB(200,200,215); hallCounter.Font = Enum.Font.Gotham
    hallCounter.TextSize = 12; hallCounter.LayoutOrder = 10; hallCounter.Parent = halloweenRace.content

    local hallActive = false
    createInteractive(halloweenRace.content, {
        Text = "Start Halloween Race", Type = "toggle", Order = 3,
        OnToggle = function(state)
            if not state then hallActive = false; stopCarNoclip(); return end
            hallActive = true; startCarNoclip()
            runRaceLoop(HALLOWEEN_POINTS, hallMode, hallSpeedRef, hallCounter, function() return hallActive end)
        end,
    })

    -- 2. Halloween Museum Race
    local museumRace = createCollapsible(raceScroll, "Halloween Museum Race", 2, false)
    local museumMode = makeRaceModeRow(museumRace.content, 1)
    local museumSpeedRef = { value = 120 }
    createNumberField(museumRace.content, {
        Text = "Fly speed", Default = 120, Min = 20, Max = 500, Order = 2,
        OnChange = function(v) museumSpeedRef.value = v end,
    })
    local MUSEUM_POINTS = {
        Vector3.new(-2158, 603, 3998), Vector3.new(-2158, 533, 3624), Vector3.new(-2325, 533, 3347),
        Vector3.new(-2710, 533, 3279), Vector3.new(-2808, 533, 3086), Vector3.new(-2812, 533, 2654),
        Vector3.new(-3044, 533, 2431), Vector3.new(-3159, 532, 2112), Vector3.new(-2850, 533, 2051),
        Vector3.new(-2781, 533, 1648), Vector3.new(-2523, 533, 1518), Vector3.new(-2423, 533, 1820),
        Vector3.new(-2710, 533, 2444), Vector3.new(-2611, 538, 2730), Vector3.new(-2483, 533, 2882),
        Vector3.new(-2641, 533, 3040), Vector3.new(-2278, 533, 3149), Vector3.new(-1971, 533, 3326),
        Vector3.new(-1961, 539, 3691), Vector3.new(-1969, 603, 4023), Vector3.new(-2158, 603, 3962),
    }
    local museumCounter = Instance.new("TextLabel")
    museumCounter.Size = UDim2.new(1,0,0,20); museumCounter.BackgroundTransparency = 1
    museumCounter.Text = "Lap: 0 | Point: 0/"..#MUSEUM_POINTS
    museumCounter.TextColor3 = Color3.fromRGB(200,200,215); museumCounter.Font = Enum.Font.Gotham
    museumCounter.TextSize = 12; museumCounter.LayoutOrder = 10; museumCounter.Parent = museumRace.content

    local museumActive = false
    createInteractive(museumRace.content, {
        Text = "Start Museum Race", Type = "toggle", Order = 3,
        OnToggle = function(state)
            if not state then museumActive = false; stopCarNoclip(); return end
            museumActive = true; startCarNoclip()
            runRaceLoop(MUSEUM_POINTS, museumMode, museumSpeedRef, museumCounter, function() return museumActive end)
        end,
    })

    -- 3. Desert Race
    local desertRace = createCollapsible(raceScroll, "Desert Race", 3, false)
    local desertMode = makeRaceModeRow(desertRace.content, 1)
    local desertSpeedRef = { value = 120 }
    createNumberField(desertRace.content, {
        Text = "Fly speed", Default = 120, Min = 20, Max = 500, Order = 2,
        OnChange = function(v) desertSpeedRef.value = v end,
    })
    local DESERT_POINTS = {
        Vector3.new(31, 604, 2161), Vector3.new(190, 603, 2435), Vector3.new(290, 603, 2841),
        Vector3.new(206, 604, 3459), Vector3.new(313, 604, 3978), Vector3.new(158, 604, 4515),
        Vector3.new(-8, 604, 4898), Vector3.new(428, 614, 5147), Vector3.new(1304, 615, 5380),
        Vector3.new(1807, 653, 5291), Vector3.new(1623, 623, 4956), Vector3.new(1858, 604, 4576),
        Vector3.new(2171, 604, 3804), Vector3.new(2178, 603, 3011), Vector3.new(1870, 604, 2743),
        Vector3.new(1673, 610, 2047), Vector3.new(1609, 604, 1326), Vector3.new(1239, 613, 821),
        Vector3.new(795, 603, 1062), Vector3.new(351, 603, 1517),
    }
    local desertCounter = Instance.new("TextLabel")
    desertCounter.Size = UDim2.new(1,0,0,20); desertCounter.BackgroundTransparency = 1
    desertCounter.Text = "Lap: 0 | Point: 0/"..#DESERT_POINTS
    desertCounter.TextColor3 = Color3.fromRGB(200,200,215); desertCounter.Font = Enum.Font.Gotham
    desertCounter.TextSize = 12; desertCounter.LayoutOrder = 10; desertCounter.Parent = desertRace.content

    local desertActive = false
    createInteractive(desertRace.content, {
        Text = "Start Desert Race", Type = "toggle", Order = 3,
        OnToggle = function(state)
            if not state then desertActive = false; stopCarNoclip(); return end
            desertActive = true; startCarNoclip()
            runRaceLoop(DESERT_POINTS, desertMode, desertSpeedRef, desertCounter, function() return desertActive end)
        end,
    })
end

local function buildConfigTab(addTab)
    local configTab=addTab("Config","config",5)
    local configScroll=Instance.new("ScrollingFrame")
    configScroll.Size=UDim2.fromScale(1,1); configScroll.BackgroundTransparency=1
    configScroll.BorderSizePixel=0; configScroll.ScrollBarThickness=4
    configScroll.CanvasSize=UDim2.new(0,0,0,0); configScroll.AutomaticCanvasSize=Enum.AutomaticSize.Y
    configScroll.Parent=configTab
    local cfp=Instance.new("UIPadding",configScroll); cfp.PaddingTop=UDim.new(0,2); cfp.PaddingBottom=UDim.new(0,2)
    local cfl=Instance.new("UIListLayout",configScroll); cfl.Padding=UDim.new(0,4); cfl.SortOrder=Enum.SortOrder.LayoutOrder

    local function serializeConfig()
        local parts={}
        for k,v in pairs(State.settings) do
            if type(v)=="boolean" or type(v)=="number" or type(v)=="string" then
                table.insert(parts,string.format("%s=%s",tostring(k),tostring(v)))
            end
        end
        return table.concat(parts,"\n")
    end
    local function deserializeConfig(text)
        local data={}
        for line in text:gmatch("[^\r\n]+") do
            local k,v=line:match("^([^=]+)=(.*)$")
            if k and v then
                if v=="true" then v=true
                elseif v=="false" then v=false
                else
                    local n=tonumber(v); if n then v=n end
                end
                data[k]=v
            end
        end
        return data
    end

    local configNameBox=Instance.new("TextBox")
    configNameBox.Size=UDim2.new(1,0,0,30)
    configNameBox.BackgroundColor3=Color3.fromRGB(34,34,42)
    configNameBox.BorderSizePixel=0; configNameBox.PlaceholderText="Config name (e.g. default)"
    configNameBox.Text="default"; configNameBox.TextColor3=Color3.fromRGB(220,220,230)
    configNameBox.Font=Enum.Font.Gotham; configNameBox.TextSize=12
    configNameBox.PlaceholderColor3=Color3.fromRGB(120,120,135)
    configNameBox.LayoutOrder=1; configNameBox.Parent=configScroll
    Instance.new("UICorner",configNameBox).CornerRadius=UDim.new(0,6)
    local cpb=Instance.new("UIPadding",configNameBox)
    cpb.PaddingLeft=UDim.new(0,10); cpb.PaddingRight=UDim.new(0,10)

    createInteractive(configScroll,{
        Text="Save config", Desc="KotostHub/Configs/<name>.cfg", Requires={"writefile"}, Order=2,
        OnClick=function()
            local name=configNameBox.Text:gsub("[^%w_%-]","")
            if #name==0 then notifyGlobal("Config","Enter name",Color3.fromRGB(200,80,80)); return end
            ensureFolders()
            local path=FOLDER_CONFIG.."/"..name..".cfg"
            local okS,err=pcall(writefile,path,serializeConfig())
            if okS then notifyGlobal("Config","Saved: "..name,Color3.fromRGB(80,200,120))
            else notifyGlobal("Config","Err: "..tostring(err),Color3.fromRGB(200,80,80)) end
        end,
    })
    createInteractive(configScroll,{
        Text="Load config", Desc="Load from KotostHub/Configs", Requires={"readfile","isfile"}, Order=3,
        OnClick=function()
            local name=configNameBox.Text:gsub("[^%w_%-]","")
            if #name==0 then notifyGlobal("Config","Enter name",Color3.fromRGB(200,80,80)); return end
            local path=FOLDER_CONFIG.."/"..name..".cfg"
            if not isfile(path) then notifyGlobal("Config","Not found: "..name,Color3.fromRGB(200,80,80)); return end
            local okR,content=pcall(readfile,path)
            if okR and content then
                for k,v in pairs(deserializeConfig(content)) do State.settings[k]=v end
                notifyGlobal("Config","Loaded: "..name,Color3.fromRGB(80,200,120))
            else notifyGlobal("Config","Read error",Color3.fromRGB(200,80,80)) end
        end,
    })
    createInteractive(configScroll,{
        Text="Delete config", Desc="Delete file", Requires={"delfile","isfile"}, Order=4,
        OnClick=function()
            local name=configNameBox.Text:gsub("[^%w_%-]","")
            if #name==0 then return end
            local path=FOLDER_CONFIG.."/"..name..".cfg"
            if not isfile(path) then notifyGlobal("Config","Not found",Color3.fromRGB(200,80,80)); return end
            pcall(delfile,path); notifyGlobal("Config","Deleted: "..name,Color3.fromRGB(240,200,60))
        end,
    })
    createInteractive(configScroll,{
        Text="List configs", Desc="Show files in folder", Requires={"listfiles"}, Order=5,
        OnClick=function()
            ensureFolders()
            local okL,list=pcall(listfiles,FOLDER_CONFIG)
            if okL and list then
                local names={}
                for _,f in ipairs(list) do
                    local n=f:match("([^/\\]+)%.cfg$"); if n then table.insert(names,n) end
                end
                notifyGlobal("Config","Found: "..#names,Color3.fromRGB(100,200,255))
            end
        end,
    })
end
local function buildEventTab(addTab)
    local eventTab=addTab("Event","event",6)
    local eventScroll=Instance.new("ScrollingFrame")
    eventScroll.Size=UDim2.fromScale(1,1); eventScroll.BackgroundTransparency=1
    eventScroll.BorderSizePixel=0; eventScroll.ScrollBarThickness=4
    eventScroll.CanvasSize=UDim2.new(0,0,0,0); eventScroll.AutomaticCanvasSize=Enum.AutomaticSize.Y
    eventScroll.Parent=eventTab
    local ep=Instance.new("UIPadding",eventScroll); ep.PaddingTop=UDim.new(0,2); ep.PaddingBottom=UDim.new(0,2)
    local el=Instance.new("UIListLayout",eventScroll); el.Padding=UDim.new(0,6); el.SortOrder=Enum.SortOrder.LayoutOrder

    -- === Halloween 2026 group ===
    local halloweenGroup = Instance.new("Frame")
    halloweenGroup.Size = UDim2.new(1,0,0,0); halloweenGroup.AutomaticSize = Enum.AutomaticSize.Y
