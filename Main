if not LocalPlayer then
    Players:GetPropertyChangedSignal("LocalPlayer"):Wait()
    LocalPlayer = Players.LocalPlayer
end
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui", 30)

local CAPS = {}
do
    local function isFn(v) return type(v) == "function" end
    local function isTbl(v) return type(v) == "table" end
    CAPS.getgenv=isFn(getgenv); CAPS.gethui=isFn(gethui); CAPS.cloneref=isFn(cloneref)
    CAPS.protectgui=isFn(protectgui); CAPS.loadstring=isFn(loadstring)
    CAPS.identifyexecutor=isFn(identifyexecutor)
    CAPS.setclipboard=isFn(setclipboard); CAPS.toclipboard=isFn(toclipboard); CAPS.setfpscap=isFn(setfpscap)
    CAPS.writefile=isFn(writefile); CAPS.readfile=isFn(readfile); CAPS.isfile=isFn(isfile)
    CAPS.isfolder=isFn(isfolder); CAPS.makefolder=isFn(makefolder); CAPS.listfiles=isFn(listfiles)
    CAPS.delfile=isFn(delfile); CAPS.delfolder=isFn(delfolder); CAPS.appendfile=isFn(appendfile)
    CAPS.getcustomasset=isFn(getcustomasset); CAPS.hookfunction=isFn(hookfunction); CAPS.hookmetamethod=isFn(hookmetamethod)
    CAPS.getnamecallmethod=isFn(getnamecallmethod); CAPS.getrawmetatable=isFn(getrawmetatable)
    CAPS.setreadonly=isFn(setreadonly); CAPS.isreadonly=isFn(isreadonly)
    CAPS.getgc=isFn(getgc); CAPS.getnilinstances=isFn(getnilinstances)
    CAPS.getconnections=isFn(getconnections); CAPS.getinstances=isFn(getinstances)
    CAPS.syn_request=isTbl(syn) and isFn(syn.request)
    CAPS.http_request=isTbl(http) and isFn(http.request)
    CAPS.request=isFn(request); CAPS.httpget_game=isFn(game.HttpGet); CAPS.httpget_fn=isFn(httpget)
    CAPS.firetouchinterest=isFn(firetouchinterest); CAPS.fireclickdetector=isFn(fireclickdetector)
    CAPS.fireproximityprompt=isFn(fireproximityprompt)
    CAPS.queue_on_teleport=isFn(queue_on_teleport) or isFn(queueonteleport)
    CAPS.Drawing=isTbl(Drawing) and isFn(Drawing.new)
    CAPS.highlight=pcall(function() local h=Instance.new("Highlight"); h:Destroy() end)
    CAPS.coregui=pcall(function() local c=Instance.new("Folder"); c.Parent=game:GetService("CoreGui"); c:Destroy() end)
    CAPS.vim = VirtualInputManager ~= nil
end

local EXEC_NAME = "Unknown"
if CAPS.identifyexecutor then
    local ok, name, ver = pcall(identifyexecutor)
    if ok and name then EXEC_NAME = tostring(name); if ver then EXEC_NAME = EXEC_NAME .. " " .. tostring(ver) end end
end

local DEVICE = "PC"
local PLATFORM_NAME = "Unknown"
do
    local ok, platform = pcall(function() return UserInputService:GetPlatform() end)
    if ok and platform then PLATFORM_NAME = tostring(platform) end
    local function hasPlatform(name)
        local ok2, e = pcall(function() return Enum.Platform[name] end)
        return ok2 and e ~= nil and e == platform
    end
    local isConsole = hasPlatform("XboxOne") or hasPlatform("PS4") or hasPlatform("PS5") or hasPlatform("XboxSeriesX")
    local isMobile = UserInputService.TouchEnabled and not UserInputService.MouseEnabled
    local isTablet = UserInputService.TouchEnabled and UserInputService.MouseEnabled
    if isConsole then DEVICE = "Console"
    elseif isMobile then DEVICE = "Mobile"
    elseif isTablet then DEVICE = "Tablet"
    else DEVICE = "PC" end
end

local function getViewport()
    local cam = workspace.CurrentCamera
    if cam then return cam.ViewportSize end
    return Vector2.new(1280, 720)
end

local function computeWindowSize()
    local v = getViewport(); local w, h = v.X, v.Y
    if DEVICE == "Mobile" then
        if h > w then return Vector2.new(math.floor(w*0.94), math.floor(h*0.62)) else return Vector2.new(math.floor(w*0.88), math.floor(h*0.88)) end
    elseif DEVICE == "Tablet" then return Vector2.new(math.min(720, math.floor(w*0.72)), math.min(460, math.floor(h*0.72)))
    elseif DEVICE == "Console" then return Vector2.new(math.min(880, math.floor(w*0.75)), math.min(520, math.floor(h*0.75)))
    else return Vector2.new(math.min(720, math.floor(w*0.8)), math.min(460, math.floor(h*0.8))) end
end

local function getGuiParent()
    if CAPS.gethui then local ok, p = pcall(gethui); if ok and p then return p end end
    if CAPS.cloneref then local ok, p = pcall(cloneref, game:GetService("CoreGui")); if ok and p then return p end end
    if CAPS.coregui then return game:GetService("CoreGui") end
    return PlayerGui
end
local GuiParent = getGuiParent()

local FOLDER_ROOT = "KotostHub"
local FOLDER_CONFIG = FOLDER_ROOT .. "/Configs"
local function ensureFolders()
    if not (CAPS.makefolder and CAPS.isfolder) then return false end
    pcall(function()
        if not isfolder(FOLDER_ROOT) then makefolder(FOLDER_ROOT) end
        if not isfolder(FOLDER_CONFIG) then makefolder(FOLDER_CONFIG) end
    end)
    return true
end
ensureFolders()

local function isLocked(requires)
    if not requires or #requires == 0 then return false, {} end
    local missing = {}
    for _, req in ipairs(requires) do if not CAPS[req] then table.insert(missing, req) end end
    return #missing > 0, missing
end

local State = {
    introGui = nil, mainGui = nil, running = true, caps = CAPS, isLocked = isLocked,
    execName = EXEC_NAME, device = DEVICE, platform = PLATFORM_NAME, statConn = nil, viewConn = nil,
    settings = {}, espHandles = {}, farmStates = {}, cleanupFns = {}, mainToggles = {},
    mobileBtnUp = nil, mobileBtnDown = nil, mobileDriveHolder = nil,
}

local Logic = {
    flyConn=nil, flySpeed=65, spinConn=nil, spinSpeed=360, noclipConn=nil, antisitConn=nil,
    infJumpConn=nil, jumpPower=50, walkSpeed=16, carSpeedConn=nil, carSpeedMax=999,
    carFlyConn=nil, carFlySpeed=80, carFlyHover=false, carFlyHoldY=nil, carFarmConn=nil, carFarmSpeed=320,
    carNoclipConn=nil, carFastStopConn=nil, carFastStop=false, carLaunchStartConn=nil, carLaunchStart=false,
    autoDriveConn=nil, autoDriveActive=false, autoDriveSpeed=300, knockConn=nil, knockActive=false,
    meshHidden={}, raceSpeed=120, timeLockerConn=nil, mobileW=false, mobileA=false, mobileS=false,
    mobileD=false, mobileUp=false, mobileDown=false,
}

local function getHumanoid() local char = LocalPlayer.Character; return char and char:FindFirstChildOfClass("Humanoid") end
local function getHRP() local char = LocalPlayer.Character; return char and char:FindFirstChild("HumanoidRootPart") end
local function getVehicle()
    local hum = getHumanoid(); local seat = hum and hum.SeatPart
    if seat and seat:IsA("VehicleSeat") then return seat.Parent, seat end
end
local function getCarRoot()
    local car, seat = getVehicle(); if not car then return nil end
    return seat.AssemblyRootPart or car.PrimaryPart or car:FindFirstChildWhichIsA("BasePart")
end
local function getPosition(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then return obj.Position end
    if obj:IsA("Model") then
        local ok, pivot = pcall(function() return obj:GetPivot() end)
        if ok and pivot then return pivot.Position end
        local ok2, bb = pcall(function() return obj:GetBoundingBox() end)
        if ok2 and bb then return bb.Position end
    end
    return nil
end
local function travelTo(targetPos, cancelCheck)
    local hrp = getHRP(); if not hrp then return false end
    local startPos = hrp.Position
    local dist = (targetPos - startPos).Magnitude
    if dist < 0.1 then return true end
    local baseSpeed = math.clamp(dist * 1.5, 100, 800)
    local duration = math.clamp(dist / baseSpeed, 0.15, 4)
    local t0 = tick()
    while true do
        if cancelCheck and cancelCheck() then return false end
        local hrp2 = getHRP(); if not hrp2 then return false end
        local elapsed = tick() - t0
        local t = math.min(1, elapsed / duration)
        hrp2.CFrame = CFrame.new(startPos:Lerp(targetPos, t ^ 0.8))
        if t >= 1 then return true end
        task.wait()
    end
end

local function teleportTo(pos)
    local hrp = getHRP(); if not hrp then return false end
    pcall(function() hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0)) end)
    return true
end

local function teleportToExact(pos)
    local hrp = getHRP(); if not hrp then return false end
    pcall(function() hrp.CFrame = CFrame.new(pos + Vector3.new(0, 0.5, 0)) end)
    return true
end

local function createEspForObject(obj, key, color)
    if not CAPS.highlight or not obj then return nil end
    local h = Instance.new("Highlight")
    h.Adornee = obj
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.FillColor = color or Color3.fromRGB(255, 140, 40)
    h.OutlineColor = color and color:Lerp(Color3.fromRGB(255,255,255), 0.4) or Color3.fromRGB(255, 210, 80)
    h.FillTransparency = 0.55; h.OutlineTransparency = 0
    h.Name = "KotostESP_"..key; h.Parent = obj
    return h
end

local function clearEspFor(key)
    local data = State.espHandles[key]; if not data then return end
    for _, h in pairs(data.highlights) do pcall(function() h:Destroy() end) end
    data.highlights = {}; data.objs = {}
    for _, c in ipairs(data.conns or {}) do pcall(function() c:Disconnect() end) end
    data.conns = {}
end

-- === Player Logic ===
local function startFly()
    if Logic.flyConn then return end
    Logic.flyConn = RunService.RenderStepped:Connect(function()
        local hrp = getHRP(); if not hrp then return end
        local dir = Vector3.zero
        local cam = workspace.CurrentCamera
        if cam then
            local cf = cam.CFrame
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cf.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cf.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + cf.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - cf.RightVector end
        end
        local up = UserInputService:IsKeyDown(Enum.KeyCode.Space) or Logic.mobileUp
        local down = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or Logic.mobileDown
        if up then dir = dir + Vector3.yAxis end
        if down then dir = dir - Vector3.yAxis end
        if dir.Magnitude > 0 then dir = dir.Unit end
        hrp.AssemblyLinearVelocity = dir * Logic.flySpeed
    end)
end
local function stopFly()
    if Logic.flyConn then pcall(function() Logic.flyConn:Disconnect() end); Logic.flyConn = nil end
end

local function startNoclip()
    if Logic.noclipConn then return end
    Logic.noclipConn = RunService.Heartbeat:Connect(function()
        local char = LocalPlayer.Character; if not char then return end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then part.CanCollide = false end
        end
    end)
end
local function stopNoclip()
    if Logic.noclipConn then pcall(function() Logic.noclipConn:Disconnect() end); Logic.noclipConn = nil end
    local char = LocalPlayer.Character
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and not part.CanCollide then pcall(function() part.CanCollide = true end) end
        end
    end
end

local function startSpin()
    if Logic.spinConn then return end
    Logic.spinConn = RunService.Heartbeat:Connect(function(dt)
        local hrp = getHRP(); if not hrp then return end
        pcall(function() hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(Logic.spinSpeed) * dt, 0) end)
    end)
end
local function stopSpin()
    if Logic.spinConn then pcall(function() Logic.spinConn:Disconnect() end); Logic.spinConn = nil end
end

local function startAntisit()
    if Logic.antisitConn then return end
    Logic.antisitConn = RunService.Heartbeat:Connect(function()
        local char = LocalPlayer.Character; if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Sit then hum.Sit = false end
    end)
end
local function stopAntisit()
    if Logic.antisitConn then pcall(function() Logic.antisitConn:Disconnect() end); Logic.antisitConn = nil end
end

local function startInfJump()
    if Logic.infJumpConn then return end
    Logic.infJumpConn = UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode ~= Enum.KeyCode.Space then return end
        local hum = getHumanoid(); local hrp = getHRP()
        if hum and hrp and hum.Health > 0 then
            local v = hrp.AssemblyLinearVelocity
            hrp.AssemblyLinearVelocity = Vector3.new(v.X, Logic.jumpPower, v.Z)
        end
    end)
end
local function stopInfJump()
    if Logic.infJumpConn then pcall(function() Logic.infJumpConn:Disconnect() end); Logic.infJumpConn = nil end
end

-- === Car Logic ===
local function startCarSpeed()
    if Logic.carSpeedConn then return end
    Logic.carSpeedConn = RunService.Stepped:Connect(function(_, dt)
        local car, seat = getVehicle(); if not car or not seat then return end
        local root = getCarRoot(); if not root then return end
        local isW = UserInputService:IsKeyDown(Enum.KeyCode.W) or Logic.mobileW
        if isW then
            local vel = root.AssemblyLinearVelocity
            local look = seat.CFrame.LookVector
            local fwd = Vector3.new(look.X, 0, look.Z)
            if fwd.Magnitude < 0.1 then return end
            fwd = fwd.Unit
            local speed = Vector3.new(vel.X, 0, vel.Z).Magnitude
            if speed < Logic.carSpeedMax then
                local add = math.min(150 * dt, Logic.carSpeedMax - speed)
                root.AssemblyLinearVelocity = vel + fwd * add
            end
        end
    end)
end
local function stopCarSpeed()
    if Logic.carSpeedConn then pcall(function() Logic.carSpeedConn:Disconnect() end); Logic.carSpeedConn = nil end
end

local function startCarFly()
    if Logic.carFlyConn then return end
    Logic.carFlyHoldY = nil
    Logic.carFlyConn = RunService.RenderStepped:Connect(function(dt)
        local car, seat = getVehicle(); if not car or not seat then return end
        local root = getCarRoot(); if not root then return end

        local look = seat.CFrame.LookVector
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude < 0.1 then
            local rl = root.CFrame.LookVector
            flat = Vector3.new(rl.X, 0, rl.Z)
        end
        if flat.Magnitude < 0.1 then flat = Vector3.new(0, 0, -1) end
        flat = flat.Unit
        root.AssemblyAngularVelocity = Vector3.zero
        pcall(function() root.CFrame = CFrame.lookAt(root.Position, root.Position + flat, Vector3.yAxis) end)

        local dir = Vector3.zero
        local cam = workspace.CurrentCamera
        if cam then
            local cf = cam.CFrame
            if UserInputService:IsKeyDown(Enum.KeyCode.W) or Logic.mobileW then dir = dir + cf.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) or Logic.mobileS then dir = dir - cf.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) or Logic.mobileD then dir = dir + cf.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) or Logic.mobileA then dir = dir - cf.RightVector end
        end

        local upPressed = UserInputService:IsKeyDown(Enum.KeyCode.Space) or Logic.mobileUp
        local downPressed = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or Logic.mobileDown

        if Logic.carFlyHover then
            if not upPressed and not downPressed then
                if not Logic.carFlyHoldY then Logic.carFlyHoldY = root.Position.Y end
                local pos = root.Position
                local rot = root.CFrame - pos
                pcall(function() root.CFrame = CFrame.new(pos.X, Logic.carFlyHoldY, pos.Z) * rot end)
                local horiz = Vector3.new(dir.X, 0, dir.Z)
                if horiz.Magnitude > 0 then horiz = horiz.Unit end
                horiz = horiz * Logic.carFlySpeed
                local cur = root.AssemblyLinearVelocity
                root.AssemblyLinearVelocity = Vector3.new(
                    cur.X + (horiz.X - cur.X) * math.clamp(dt*10,0,1), 0,
                    cur.Z + (horiz.Z - cur.Z) * math.clamp(dt*10,0,1)
                )
            else
                if upPressed then dir = dir + Vector3.yAxis end
                if downPressed then dir = dir - Vector3.yAxis end
                if dir.Magnitude > 0 then dir = dir.Unit end
                local target = dir * Logic.carFlySpeed
                local cur = root.AssemblyLinearVelocity
                root.AssemblyLinearVelocity = cur:Lerp(target, math.clamp(dt * 10, 0, 1))
                Logic.carFlyHoldY = root.Position.Y
            end
        else
            if upPressed then dir = dir + Vector3.yAxis end
            if downPressed then dir = dir - Vector3.yAxis end
            if dir.Magnitude > 0 then dir = dir.Unit end
            local target = dir * Logic.carFlySpeed
            local cur = root.AssemblyLinearVelocity
            if upPressed or downPressed then
                root.AssemblyLinearVelocity = cur:Lerp(target, math.clamp(dt * 10, 0, 1))
            else
                root.AssemblyLinearVelocity = cur:Lerp(Vector3.new(target.X, cur.Y, target.Z), math.clamp(dt * 8, 0, 1))
            end
        end
    end)
end
local function stopCarFly()
    if Logic.carFlyConn then pcall(function() Logic.carFlyConn:Disconnect() end); Logic.carFlyConn = nil end
    Logic.carFlyHoldY = nil
end

local function startCarFarm()
    if Logic.carFarmConn then return end
    local startCF, startPos, dir = nil, nil, nil
    Logic.carFarmConn = RunService.Stepped:Connect(function(_, dt)
        local car, seat = getVehicle(); if not car or not seat then return end
        local root = getCarRoot(); if not root then return end
        if not startCF then
            startCF = root.CFrame; startPos = root.Position
            local look = seat.CFrame.LookVector
            dir = Vector3.new(look.X, 0, look.Z)
            if dir.Magnitude < 0.1 then dir = Vector3.new(0, 0, -1) end
            dir = dir.Unit
        end
        local traveled = (root.Position - startPos):Dot(dir)
        if traveled > 3000 then
            root.CFrame = startCF
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        else
            root.AssemblyAngularVelocity = Vector3.zero
            root.AssemblyLinearVelocity = dir * Logic.carFarmSpeed + Vector3.new(0, -15, 0)
            root.CFrame = CFrame.lookAt(root.Position, root.Position + dir)
        end
    end)
end
local function stopCarFarm()
    if Logic.carFarmConn then pcall(function() Logic.carFarmConn:Disconnect() end); Logic.carFarmConn = nil end
end

-- === FIXED CAR NOCLIP ===
local function startCarNoclip()
    if Logic.carNoclipConn then return end
    Logic.carNoclipConn = RunService.Heartbeat:Connect(function()
        local car, seat = getVehicle(); if not seat then return end
        local parts = seat:GetConnectedParts(true)
        for _, part in ipairs(parts) do
            if part:IsA("BasePart") then
                part.CanCollide = false
                part.CanQuery = false
                part.CanTouch = false
            end
        end
    end)
end
local function stopCarNoclip()
    if Logic.carNoclipConn then pcall(function() Logic.carNoclipConn:Disconnect() end); Logic.carNoclipConn = nil end
    local car, seat = getVehicle(); if not seat then return end
    local parts = seat:GetConnectedParts(true)
    for _, part in ipairs(parts) do
        if part:IsA("BasePart") then
            part.CanCollide = true
            part.CanQuery = true
            part.CanTouch = true
        end
    end
end

local function startCarFastStop()
    if Logic.carFastStopConn then return end
    Logic.carFastStopConn = RunService.Stepped:Connect(function(_, dt)
        local car, seat = getVehicle(); if not car or not seat then return end
        local root = getCarRoot(); if not root then return end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) or Logic.mobileS then
            local v = root.AssemblyLinearVelocity
            root.AssemblyLinearVelocity = Vector3.new(0, v.Y, 0)
        end
    end)
end
local function stopCarFastStop()
    if Logic.carFastStopConn then pcall(function() Logic.carFastStopConn:Disconnect() end); Logic.carFastStopConn = nil end
end

local function startCarLaunchStart()
    if Logic.carLaunchStartConn then return end
    local wasW = false
    Logic.carLaunchStartConn = RunService.Stepped:Connect(function(_, dt)
        local car, seat = getVehicle(); if not car or not seat then return end
        local root = getCarRoot(); if not root then return end
        local isW = UserInputService:IsKeyDown(Enum.KeyCode.W) or Logic.mobileW
        if isW and not wasW then
            local look = seat.CFrame.LookVector
            local fwd = Vector3.new(look.X, 0, look.Z)
            if fwd.Magnitude > 0.1 then
                fwd = fwd.Unit
                local v = root.AssemblyLinearVelocity
                root.AssemblyLinearVelocity = fwd * Logic.carSpeedMax + Vector3.new(0, v.Y, 0)
            end
        end
        wasW = isW
    end)
end
local function stopCarLaunchStart()
    if Logic.carLaunchStartConn then pcall(function() Logic.carLaunchStartConn:Disconnect() end); Logic.carLaunchStartConn = nil end
end

local AUTO_A = Vector3.new(-4963, 603, 5236)
local AUTO_B = Vector3.new(-4946, 603, 2328)
local function startAutoDrive()
    if Logic.autoDriveConn then return end
    Logic.autoDriveActive = true
    local phase = "teleportA"
    Logic.autoDriveConn = RunService.Stepped:Connect(function(_, dt)
        if not Logic.autoDriveActive then return end
        local car, seat = getVehicle()
        if not car or not seat then
            Logic.autoDriveActive = false
            if Logic.autoDriveConn then pcall(function() Logic.autoDriveConn:Disconnect() end); Logic.autoDriveConn = nil end
            return
        end
        local root = seat.AssemblyRootPart or car.PrimaryPart or car:FindFirstChildWhichIsA("BasePart")
        if not root then return end
        if phase == "teleportA" then
            root.CFrame = CFrame.lookAt(AUTO_A, AUTO_B)
            root.AssemblyLinearVelocity = (AUTO_B - AUTO_A).Unit * Logic.autoDriveSpeed
            phase = "toB"
        elseif phase == "toB" then
            local dir = (AUTO_B - root.Position)
            local dist = Vector3.new(dir.X, 0, dir.Z).Magnitude
            if dist < 8 then
                root.CFrame = CFrame.lookAt(AUTO_A, AUTO_B)
                root.AssemblyLinearVelocity = (AUTO_B - AUTO_A).Unit * Logic.autoDriveSpeed
                phase = "toB"
            else
                root.AssemblyAngularVelocity = Vector3.zero
                root.AssemblyLinearVelocity = (AUTO_B - AUTO_A).Unit * Logic.autoDriveSpeed
                root.CFrame = CFrame.lookAt(root.Position, root.Position + (AUTO_B - AUTO_A).Unit)
            end
        end
    end)
end
local function stopAutoDrive()
    Logic.autoDriveActive = false
    if Logic.autoDriveConn then pcall(function() Logic.autoDriveConn:Disconnect() end); Logic.autoDriveConn = nil end
end

local function pressE()
    if CAPS.vim then
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(0.05)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        end)
    end
end

local function startKnockKnock()
    if Logic.knockConn then return end
    Logic.knockActive = true
    task.spawn(function()
        while Logic.knockActive do
            local h = workspace:FindFirstChild("Halloween2026")
            local folder = h and h:FindFirstChild("HalloweenHouses")
            if not folder then break end
            local houses = {}
            for _, m in ipairs(folder:GetChildren()) do if m:IsA("Model") then table.insert(houses, m) end end
            if #houses == 0 then break end
            for _, model in ipairs(houses) do
                if not Logic.knockActive then break end
                local door = model:FindFirstChild("HalloweenDoor", true)
                if door then
                    local pos = getPosition(door)
                    if pos then
                        teleportToExact(pos)
                        task.wait(0.5); pressE(); task.wait(0.1); pressE(); task.wait(0.6)
                    end
                end
            end
            Logic.knockActive = false
            if Logic.knockConn then pcall(function() Logic.knockConn() end); Logic.knockConn = nil end
        end
    end)
    Logic.knockConn = function() Logic.knockActive = false end
end
local function stopKnockKnock()
    Logic.knockActive = false
    Logic.knockConn = nil
end

local function applyMeshSwap(assetId)
    local car = getVehicle(); if not car then return end
    task.spawn(function()
        local ok, model = pcall(function() return InsertService:LoadAsset(assetId) end)
        if not ok or not model then
            local ok2, objs = pcall(function() return game:GetObjects("rbxassetid://" .. tostring(assetId)) end)
            if ok2 and objs and objs[1] then model = objs[1]; ok = true end
        end
        if not ok or not model then return end
        local mesh = model:FindFirstChildWhichIsA("MeshPart", true) or model:FindFirstChildWhichIsA("BasePart", true)
        if not mesh then pcall(function() model:Destroy() end); return end
        local root = car.PrimaryPart or car:FindFirstChildWhichIsA("BasePart")
        if not root then pcall(function() model:Destroy() end); return end
        local clone = mesh:Clone()
        clone.Name = "KotostMesh_" .. assetId
        clone.CFrame = root.CFrame; clone.Anchored = false; clone.CanCollide = false; clone.Massless = true; clone.Parent = car
        local weld = Instance.new("WeldConstraint"); weld.Part0 = root; weld.Part1 = clone; weld.Parent = clone
        for _, part in ipairs(car:GetDescendants()) do
            if part:IsA("BasePart") and part ~= root and part ~= clone and not part:IsDescendantOf(clone) then
                Logic.meshHidden[part] = part.Transparency; part.Transparency = 1
            end
        end
        pcall(function() model:Destroy() end)
    end)
end

local function restoreMesh()
    local car = getVehicle(); if not car then return end
    for part, tr in pairs(Logic.meshHidden) do if part.Parent then part.Transparency = tr end end
    Logic.meshHidden = {}
    for _, part in ipairs(car:GetDescendants()) do if part.Name:find("KotostMesh_") then pcall(function() part:Destroy() end) end end
end

local function startTimeLocker()
    if Logic.timeLockerConn then return end
    local baseTime = Lighting.ClockTime
    Logic.timeLockerConn = RunService.Heartbeat:Connect(function()
        Lighting.ClockTime = baseTime
    end)
end
local function stopTimeLocker()
    if Logic.timeLockerConn then pcall(function() Logic.timeLockerConn:Disconnect() end); Logic.timeLockerConn = nil end
end
local notifyGlobal = function() end

local function makeNotifier(gui)
    local area=Instance.new("Frame")
    area.AnchorPoint=Vector2.new(1,0); area.Position=UDim2.new(1,-10,0,10)
    area.Size=UDim2.new(0,260,0,0); area.AutomaticSize=Enum.AutomaticSize.Y
    area.BackgroundTransparency=1; area.ZIndex=99999; area.Parent=gui
    local l=Instance.new("UIListLayout",area); l.Padding=UDim.new(0,6); l.SortOrder=Enum.SortOrder.LayoutOrder
    local n=0
    return function(title,text,color)
        n=n+1
        local f=Instance.new("Frame")
        f.Size=UDim2.new(1,0,0,0); f.AutomaticSize=Enum.AutomaticSize.Y
        f.BackgroundColor3=Color3.fromRGB(40,40,50); f.BorderSizePixel=0
        f.LayoutOrder=n; f.ZIndex=99999; f.Parent=area
        Instance.new("UICorner",f).CornerRadius=UDim.new(0,6)
        local st=Instance.new("UIStroke",f); st.Color=color or Color3.fromRGB(80,80,100); st.Thickness=1
        local lbl=Instance.new("TextLabel")
        lbl.Size=UDim2.new(1,-16,0,0); lbl.AutomaticSize=Enum.AutomaticSize.Y
        lbl.Position=UDim2.fromOffset(8,6); lbl.BackgroundTransparency=1
        lbl.Text=title .. (text and ("\n"..text) or "")
        lbl.TextColor3=Color3.fromRGB(220,220,230); lbl.Font=Enum.Font.Gotham
        lbl.TextSize=12; lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.TextWrapped=true
        lbl.TextYAlignment=Enum.TextYAlignment.Top; lbl.Parent=f
        local p=Instance.new("UIPadding",lbl); p.PaddingBottom=UDim.new(0,6); p.PaddingRight=UDim.new(0,8)
        task.delay(4,function() pcall(function() if f and f.Parent then f:Destroy() end end) end)
    end
end

local function makeIntro(onDone)
    local gui = Instance.new("ScreenGui")
    gui.Name = "KotostIntro_"..tostring(math.random(1,1e6))
    gui.ResetOnSpawn=false; gui.IgnoreGuiInset=true; gui.DisplayOrder=999999
    gui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
    if CAPS.protectgui then pcall(protectgui, gui) end
    local ok=pcall(function() gui.Parent=GuiParent end)
    if not ok or not gui.Parent then gui.Parent=PlayerGui end

    local bg=Instance.new("Frame")
    bg.BackgroundColor3=Color3.fromRGB(0,0,0); bg.BackgroundTransparency=1
    bg.BorderSizePixel=0; bg.Size=UDim2.fromScale(1,1); bg.ZIndex=1; bg.Parent=gui

    local blur=Instance.new("BlurEffect"); blur.Size=0; blur.Parent=Lighting
    local vp=getViewport(); local centerY=vp.Y*0.42; local squareSize=160
    local holder=Instance.new("Frame")
    holder.Size=UDim2.fromOffset(squareSize,squareSize); holder.Position=UDim2.new(0.5,0,0,centerY)
    holder.AnchorPoint=Vector2.new(0.5,0.5); holder.BackgroundTransparency=1
    holder.ClipsDescendants=true; holder.ZIndex=3; holder.Parent=bg

    local holderScale=Instance.new("UIScale"); holderScale.Scale=1; holderScale.Parent=holder
    local mask=Instance.new("Frame")
    mask.Size=UDim2.new(1,0,0,0); mask.BackgroundTransparency=1; mask.ClipsDescendants=true; mask.Parent=holder

    local img=Instance.new("ImageLabel")
    img.Size=UDim2.fromOffset(squareSize,squareSize); img.Position=UDim2.new(0.5,0,0,0); img.AnchorPoint=Vector2.new(0.5,0)
    img.BackgroundTransparency=1; img.Image="rbxassetid://77128719632427"; img.ScaleType=Enum.ScaleType.Stretch; img.Parent=mask

    local halo=Instance.new("Frame")
    halo.Size=UDim2.fromOffset(squareSize+40,squareSize+40); halo.Position=UDim2.new(0.5,0,0,centerY); halo.AnchorPoint=Vector2.new(0.5,0.5)
    halo.BackgroundColor3=Color3.fromRGB(100,200,255); halo.BackgroundTransparency=1; halo.BorderSizePixel=0; halo.ZIndex=2; halo.Parent=bg
    Instance.new("UICorner",halo).CornerRadius=UDim.new(0,24)

    local textY=centerY+(squareSize/2)+50
    local title=Instance.new("TextLabel")
    title.Size=UDim2.new(1,0,0,60); title.Position=UDim2.new(0.5,0,0,textY+60); title.AnchorPoint=Vector2.new(0.5,0.5)
    title.BackgroundTransparency=1; title.Text="kotost games hub"; title.TextColor3=Color3.fromRGB(255,255,255)
    title.Font=Enum.Font.GothamBlack; title.TextSize=36; title.TextTransparency=1; title.ZIndex=3; title.Parent=bg

    local line=Instance.new("Frame")
    line.Size=UDim2.fromOffset(0,3); line.Position=UDim2.new(0.5,0,0,textY+38); line.AnchorPoint=Vector2.new(0.5,0.5)
    line.BackgroundColor3=Color3.fromRGB(100,200,255); line.BorderSizePixel=0; line.ZIndex=3; line.Parent=bg

    TweenService:Create(bg,TweenInfo.new(0.4),{BackgroundTransparency=0}):Play()
    TweenService:Create(blur,TweenInfo.new(0.5),{Size=14}):Play()

    task.spawn(function()
        task.wait(0.15)
        TweenService:Create(mask,TweenInfo.new(0.7,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Size=UDim2.new(1,0,1,0)}):Play()
        task.wait(0.6)
        TweenService:Create(title,TweenInfo.new(0.6,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Position=UDim2.new(0.5,0,0,textY),TextTransparency=0}):Play()
        task.wait(0.55)
        TweenService:Create(line,TweenInfo.new(0.4,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Size=UDim2.fromOffset(240,3)}):Play()
        task.wait(0.15)
        TweenService:Create(holderScale,TweenInfo.new(0.14),{Scale=1.07}):Play()
        TweenService:Create(halo,TweenInfo.new(0.14),{BackgroundTransparency=0.65}):Play()
        task.wait(0.14)
        TweenService:Create(holderScale,TweenInfo.new(0.22),{Scale=1}):Play()
        TweenService:Create(halo,TweenInfo.new(0.35),{BackgroundTransparency=1}):Play()
        task.wait(1.2)
        if not State.running then return end
        local fade=TweenInfo.new(0.5,Enum.EasingStyle.Quad,Enum.EasingDirection.InOut)
        TweenService:Create(bg,fade,{BackgroundTransparency=1}):Play()
        TweenService:Create(title,fade,{TextTransparency=1}):Play()
        TweenService:Create(line,fade,{BackgroundTransparency=1}):Play()
        TweenService:Create(halo,fade,{BackgroundTransparency=1}):Play()
        TweenService:Create(mask,fade,{Size=UDim2.new(1,0,0,0)}):Play()
        TweenService:Create(blur,fade,{Size=0}):Play()
        task.wait(0.55)
        pcall(function() blur:Destroy() end)
        pcall(function() gui:Destroy() end)
        if onDone then pcall(onDone) end
    end)
    return gui
end

local function getPing()
    local ok, ping = pcall(function() return LocalPlayer:GetNetworkPing() end)
    if ok and type(ping) == "number" then return math.floor(ping * 1000) end
    local ok2, val = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
    if ok2 and type(val) == "number" then return math.floor(val) end
    return -1
end

local function createInteractive(parent,opts)
    opts=opts or {}
    local type_=opts.Type or "button"
    local locked,missing=isLocked(opts.Requires)
    local rowHeight=opts.Desc and 44 or 30

    local row=Instance.new("TextButton")
    row.Size=UDim2.new(1,0,0,rowHeight)
    row.BackgroundColor3=locked and Color3.fromRGB(28,28,32) or Color3.fromRGB(34,34,42)
    row.BorderSizePixel=0; row.Text=""; row.AutoButtonColor=false
    row.LayoutOrder=opts.Order or 0; row.Parent=parent
    Instance.new("UICorner",row).CornerRadius=UDim.new(0,6)
    if locked then
        local st=Instance.new("UIStroke",row); st.Color=Color3.fromRGB(60,60,70); st.Thickness=1
    end

    local title=Instance.new("TextLabel")
    title.Size=UDim2.new(1,-70,0,16); title.Position=UDim2.fromOffset(10,opts.Desc and 5 or 7)
    title.BackgroundTransparency=1; title.Text=(locked and "[LOCK] " or "")..(opts.Text or "Button")
    title.TextColor3=locked and Color3.fromRGB(120,120,135) or Color3.fromRGB(220,220,230)
    title.Font=Enum.Font.GothamMedium; title.TextSize=13
    title.TextXAlignment=Enum.TextXAlignment.Left; title.TextTruncate=Enum.TextTruncate.AtEnd; title.Parent=row

    if opts.Desc then
        local desc=Instance.new("TextLabel")
        desc.Size=UDim2.new(1,-70,0,14); desc.Position=UDim2.fromOffset(10,22)
        desc.BackgroundTransparency=1; desc.Text=locked and ("Need: "..table.concat(missing,", ")) or opts.Desc
        desc.TextColor3=locked and Color3.fromRGB(140,100,100) or Color3.fromRGB(150,150,165)
        desc.Font=Enum.Font.Gotham; desc.TextSize=11
        desc.TextXAlignment=Enum.TextXAlignment.Left; desc.TextTruncate=Enum.TextTruncate.AtEnd; desc.Parent=row
    end

    local sw,ball,active=nil,nil,false
    if type_=="toggle" then
        sw=Instance.new("Frame")
        sw.AnchorPoint=Vector2.new(1,0.5); sw.Position=UDim2.new(1,-10,0.5,0)
        sw.Size=UDim2.fromOffset(38,20)
        sw.BackgroundColor3=locked and Color3.fromRGB(45,45,55) or Color3.fromRGB(60,60,75)
        sw.BorderSizePixel=0; sw.Parent=row
        Instance.new("UICorner",sw).CornerRadius=UDim.new(1,0)
        ball=Instance.new("Frame")
        ball.Size=UDim2.fromOffset(16,16); ball.Position=UDim2.new(0,2,0.5,-8)
        ball.BackgroundColor3=locked and Color3.fromRGB(90,90,100) or Color3.fromRGB(200,200,210)
        ball.BorderSizePixel=0; ball.Parent=sw
        Instance.new("UICorner",ball).CornerRadius=UDim.new(1,0)
    end

    local api={row=row,isLocked=locked,missing=missing}

    if not locked then
        row.MouseEnter:Connect(function() row.BackgroundColor3=Color3.fromRGB(48,48,60) end)
        row.MouseLeave:Connect(function() row.BackgroundColor3=Color3.fromRGB(34,34,42) end)
        row.MouseButton1Click:Connect(function()
            if type_=="toggle" then
                active=not active
                if active then
                    sw.BackgroundColor3=Color3.fromRGB(80,200,120)
                    ball.Position=UDim2.new(1,-18,0.5,-8)
                else
                    sw.BackgroundColor3=Color3.fromRGB(60,60,75)
                    ball.Position=UDim2.new(0,2,0.5,-8)
                end
                if opts.OnToggle then pcall(opts.OnToggle,active) end
            else
                if opts.OnClick then pcall(opts.OnClick) end
            end
        end)
    else
        row.MouseButton1Click:Connect(function()
            notifyGlobal("Locked","Need: "..table.concat(missing,", "),Color3.fromRGB(200,80,80))
        end)
    end

    function api.setActive(v)
        if type_~="toggle" or locked then return end
        active=v==true
        if active then
            sw.BackgroundColor3=Color3.fromRGB(80,200,120)
            ball.Position=UDim2.new(1,-18,0.5,-8)
        else
            sw.BackgroundColor3=Color3.fromRGB(60,60,75)
            ball.Position=UDim2.new(0,2,0.5,-8)
        end
    end
    function api.getActive() return active end
    return api
end

local function createNumberField(parent, opts)
    opts = opts or {}
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1,0,0,30); row.BackgroundColor3 = Color3.fromRGB(34,34,42)
    row.BorderSizePixel = 0; row.LayoutOrder = opts.Order or 0; row.Parent = parent
    Instance.new("UICorner",row).CornerRadius = UDim.new(0,6)

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1,-120,1,0); title.Position = UDim2.fromOffset(10,0)
    title.BackgroundTransparency = 1; title.Text = opts.Text or "Value"
    title.TextColor3 = Color3.fromRGB(220,220,230); title.Font = Enum.Font.GothamMedium; title.TextSize = 13
    title.TextXAlignment = Enum.TextXAlignment.Left; title.Parent = row

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0,100,1,0); box.Position = UDim2.new(1,-110,0,0)
    box.BackgroundColor3 = Color3.fromRGB(20,20,26); box.BorderSizePixel = 0
    box.Text = tostring(opts.Default or ""); box.PlaceholderText = "0"
    box.TextColor3 = Color3.fromRGB(220,220,230); box.Font = Enum.Font.Gotham; box.TextSize = 12
    box.ClearTextOnFocus = false; box.Parent = row
    Instance.new("UICorner",box).CornerRadius = UDim.new(0,4)
    local pad = Instance.new("UIPadding",box); pad.PaddingLeft = UDim.new(0,6); pad.PaddingRight = UDim.new(0,6)

    local minV = opts.Min or 0; local maxV = opts.Max or 99999
    local function apply()
        local n = tonumber(box.Text); if not n then return end
        n = math.clamp(math.floor(n+0.5), minV, maxV)
        box.Text = tostring(n)
        if opts.OnChange then pcall(opts.OnChange, n) end
    end
    box.FocusLost:Connect(apply)
    return { get = function() return tonumber(box.Text) or opts.Default end }
end

local function createCollapsible(parent, titleText, order, defaultOpen)
    local holder=Instance.new("Frame")
    holder.Size=UDim2.new(1,0,0,32); holder.BackgroundColor3=Color3.fromRGB(28,28,34)
    holder.BorderSizePixel=0; holder.LayoutOrder=order or 0; holder.Parent=parent; holder.ClipsDescendants=false
    Instance.new("UICorner",holder).CornerRadius=UDim.new(0,6)
    local st=Instance.new("UIStroke",holder); st.Color=Color3.fromRGB(45,45,55); st.Thickness=1
    local layout=Instance.new("UIListLayout",holder); layout.Padding=UDim.new(0,0); layout.SortOrder=Enum.SortOrder.LayoutOrder

    local header=Instance.new("TextButton")
    header.Size=UDim2.new(1,0,0,32); header.BackgroundTransparency=1; header.Text=""; header.LayoutOrder=1; header.AutoButtonColor=false; header.Parent=holder

    local titleLbl=Instance.new("TextLabel")
    titleLbl.Size=UDim2.new(1,-50,1,0); titleLbl.Position=UDim2.fromOffset(12,0)
    titleLbl.BackgroundTransparency=1; titleLbl.Text=titleText; titleLbl.TextColor3=Color3.fromRGB(210,210,220)
    titleLbl.Font=Enum.Font.GothamMedium; titleLbl.TextSize=13; titleLbl.TextXAlignment=Enum.TextXAlignment.Left; titleLbl.Parent=header

    local arrow=Instance.new("TextLabel")
    arrow.Size=UDim2.fromOffset(30,32); arrow.Position=UDim2.new(1,-32,0,0); arrow.BackgroundTransparency=1; arrow.Text=">"
    arrow.TextColor3=Color3.fromRGB(150,150,165); arrow.Font=Enum.Font.Gotham; arrow.TextSize=12; arrow.Parent=header

    local content=Instance.new("Frame")
    content.Size=UDim2.new(1,-16,0,0); content.Position=UDim2.fromOffset(8,0); content.BackgroundTransparency=1
    content.LayoutOrder=2; content.AutomaticSize=Enum.AutomaticSize.Y; content.Parent=holder
    local cpad=Instance.new("UIPadding",content); cpad.PaddingBottom=UDim.new(0,8); cpad.PaddingTop=UDim.new(0,2)
    local clayout=Instance.new("UIListLayout",content); clayout.Padding=UDim.new(0,4); clayout.SortOrder=Enum.SortOrder.LayoutOrder

    local opened=false; local anim=nil; local generation=0
    local function setOpen(v, instant)
        generation=generation+1; local myGen=generation; local wantOpen=v==true
        if opened==wantOpen and not instant then return end
        opened=wantOpen; arrow.Text=opened and "v" or ">"
        if anim then pcall(function() anim:Cancel() end); anim=nil end

        if instant then
            content.Visible=opened
            if opened then holder.AutomaticSize=Enum.AutomaticSize.Y; holder.Size=UDim2.new(1,0,0,0)
            else holder.AutomaticSize=Enum.AutomaticSize.None; holder.Size=UDim2.new(1,0,0,32) end
            holder.ClipsDescendants=false; return
        end

        if opened then
            content.Visible=true; holder.ClipsDescendants=true; holder.AutomaticSize=Enum.AutomaticSize.None; holder.Size=UDim2.new(1,0,0,32)
            task.spawn(function()
                RunService.Heartbeat:Wait(); RunService.Heartbeat:Wait()
                if myGen~=generation or not opened then return end
                local targetH=32+content.AbsoluteSize.Y; if targetH<32 then targetH=32 end
                anim=TweenService:Create(holder,TweenInfo.new(0.25,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Size=UDim2.new(1,0,0,targetH)})
                anim:Play()
                anim.Completed:Once(function()
                    if myGen~=generation or not opened then return end
                    holder.AutomaticSize=Enum.AutomaticSize.Y; holder.ClipsDescendants=false
                end)
            end)
        else
            local currentH=math.max(holder.AbsoluteSize.Y,32)
            holder.AutomaticSize=Enum.AutomaticSize.None; holder.Size=UDim2.new(1,0,0,currentH); holder.ClipsDescendants=true
            anim=TweenService:Create(holder,TweenInfo.new(0.25,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{Size=UDim2.new(1,0,0,32)})
            anim:Play()
            anim.Completed:Once(function()
                if myGen~=generation or opened then return end
                content.Visible=false; holder.AutomaticSize=Enum.AutomaticSize.None; holder.Size=UDim2.new(1,0,0,32); holder.ClipsDescendants=false
            end)
        end
    end
    header.MouseButton1Click:Connect(function() setOpen(not opened) end)
    setOpen(defaultOpen or false, true)
    return {holder=holder, content=content, setOpen=setOpen}
end

