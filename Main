    bossInfo.Text = "🎃 Coming Soon 🎃\nBoss fight auto-farm will be added here."
    bossInfo.TextColor3 = Color3.fromRGB(255,180,80); bossInfo.Font = Enum.Font.GothamMedium
    bossInfo.TextSize = 13; bossInfo.TextWrapped = true
    bossInfo.TextXAlignment = Enum.TextXAlignment.Center; bossInfo.TextYAlignment = Enum.TextYAlignment.Center
    bossInfo.LayoutOrder = 1; bossInfo.Parent = bossSection.content
end
local function createMobileDriveControls(gui)
    if DEVICE ~= "Mobile" and DEVICE ~= "Tablet" then return end

    -- Общий контейнер для всех кнопок
    local holder = Instance.new("Frame")
    holder.Name = "MobileDriveHolder"
    holder.Size = UDim2.new(1, 0, 0, 200)
    holder.Position = UDim2.new(0, 0, 1, -200) -- Привязка к низу экрана
    holder.BackgroundTransparency = 1
    holder.Visible = false
    holder.Parent = gui

    -- Масштабирование под разные экраны телефонов
    local scale = Instance.new("UIScale", holder)
    local cam = workspace.CurrentCamera
    local function updateScale()
        if not cam then return end
        local vp = cam.ViewportSize
        scale.Scale = math.clamp(vp.X / 800, 0.6, 1.2) 
    end
    updateScale()
    if cam then cam:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale) end

    local function makeBtn(text, pos, size)
        local btn = Instance.new("TextButton")
        btn.Size = size or UDim2.fromOffset(60, 60)
        btn.Position = pos
        btn.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
        btn.BackgroundTransparency = 0.3
        btn.Text = text
        btn.TextColor3 = Color3.fromRGB(230, 230, 240)
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 24
        btn.AutoButtonColor = false
        btn.Parent = holder
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 12)
        local st = Instance.new("UIStroke", btn)
        st.Color = Color3.fromRGB(90, 140, 220)
        st.Thickness = 1.5
        return btn
    end

    -- 1. Кнопки WASD (слева)
    local btnA = makeBtn("A", UDim2.fromOffset(20, 60))
    local btnD = makeBtn("D", UDim2.fromOffset(140, 60))
    local btnW = makeBtn("W", UDim2.fromOffset(80, 0))
    local btnS = makeBtn("S", UDim2.fromOffset(80, 120))

    -- 2. Кнопки Стрелок (справа)
    local btnUp = makeBtn("^", UDim2.new(1, -150, 0, 0))
    local btnDown = makeBtn("v", UDim2.new(1, -150, 0, 120))

    local function bind(btn, varName)
        btn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
                Logic[varName] = true
                btn.BackgroundColor3 = Color3.fromRGB(80, 200, 120)
            end
        end)
        btn.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
                Logic[varName] = false
                btn.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
            end
        end)
    end

    bind(btnW, "mobileW")
    bind(btnA, "mobileA")
    bind(btnS, "mobileS")
    bind(btnD, "mobileD")
    bind(btnUp, "mobileUp")
    bind(btnDown, "mobileDown")

    -- Сохраняем в State, чтобы Main Tab мог это включать/выключать
    State.mobileDriveHolder = holder
    State.mobileBtns = { W = btnW, A = btnA, S = btnS, D = btnD, Up = btnUp, Down = btnDown }
end
local function buildFullMainGui()
    -- 1. Создаем каркас окна (возвращает объекты для управления)
    local gui, window, windowScale, addTab, selectTab, tabs, tabButtons, contentInner = makeMainGui()

    -- 2. Создаем мобильные кнопки (они появятся только на телефонах при включении Car Fly)
    createMobileDriveControls(gui)

    -- 3. Строим вкладки
    buildInfoTab(addTab)
    buildMainTab(addTab)
    buildVisualsTab(addTab)
    buildRaceTab(addTab)
    buildConfigTab(addTab)
    buildEventTab(addTab)

    -- 4. Открываем вкладку Info по умолчанию
    selectTab("Info")

    -- 5. Подгоняем размер окна при повороте экрана телефона/ресайзе ПК
    local cam = workspace.CurrentCamera
    if cam then
        local conn
        conn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
            if not window.Parent then
                if conn then conn:Disconnect() end
                return
            end
            local s = computeWindowSize()
            window.Size = UDim2.fromOffset(s.X, s.Y)
        end)
        State.viewConn = conn
    end

    -- 6. Добавляем функцию очистки (чтобы при закрытии все скрипты выключились)
    table.insert(State.cleanupFns, function()
        for key in pairs(State.espHandles) do clearEspFor(key) end
        State.farmStates = {}
        pcall(stopFly); pcall(stopNoclip); pcall(stopSpin); pcall(stopAntisit); pcall(stopInfJump)
        pcall(stopCarSpeed); pcall(stopCarFly); pcall(stopCarFarm); pcall(stopCarNoclip); pcall(stopCarFastStop); pcall(stopCarLaunchStart)
        pcall(stopAutoDrive); pcall(stopKnockKnock)
    end)

    return gui
end
-- Запускаем Интро, после которого собирается Main Gui
State.introGui = makeIntro(function()
    if not State.running then return end
    task.defer(function()
        if not State.running then return end
        State.mainGui = buildFullMainGui()
    end)
end)

-- Регистрируем глобальную функцию для полной выгрузки
getgenv().__KotostHub = State

getgenv().__KotostHub.cleanup = function()
    State.running = false

    -- Отключаем статистику и ресайз
    if State.statConn then pcall(function() State.statConn:Disconnect() end); State.statConn = nil end
    if State.viewConn then pcall(function() State.viewConn:Disconnect() end); State.viewConn = nil end

    -- Выключаем все эффекты (ESP, Fly, Car, Time и т.д.)
    for _, fn in ipairs(State.cleanupFns) do pcall(fn) end
    State.cleanupFns = {}

    -- Уничтожаем GUI
    if State.introGui then pcall(function() State.introGui:Destroy() end); State.introGui = nil end
    if State.mainGui then pcall(function() State.mainGui:Destroy() end); State.mainGui = nil end

    -- Удаляем ссылку из памяти
    getgenv().__KotostHub = nil
end
