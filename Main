    local mazeLocs={"Castle1","Castle2","Cornfield1","Cornfield2"}
    local function refreshMazeButtons()
        for _,loc in ipairs(mazeLocs) do
            local btn=mazeButtons[loc]
            if btn then
                if loc==selectedMaze then
                    btn.BackgroundColor3=Color3.fromRGB(80,200,120); btn.TextColor3=Color3.fromRGB(15,15,20)
                else
                    btn.BackgroundColor3=Color3.fromRGB(50,50,62); btn.TextColor3=Color3.fromRGB(220,220,230)
                end
            end
        end
    end
    for i,loc in ipairs(mazeLocs) do
