        btn.Size=UDim2.new(0.25,-3,1,0)
        btn.BackgroundColor3=Color3.fromRGB(50,50,62)
        btn.BorderSizePixel=0; btn.Text=loc
        btn.TextColor3=Color3.fromRGB(220,220,230)
        btn.Font=Enum.Font.GothamMedium; btn.TextSize=11
        btn.LayoutOrder=i; btn.Parent=mazeBtnHolder
        Instance.new("UICorner",btn).CornerRadius=UDim.new(0,5)
        btn.MouseButton1Click:Connect(function() selectedMaze=loc; refreshMazeButtons() end)
        mazeButtons[loc]=btn
    end
    refreshMazeButtons()

    local mazeCounterLabel=Instance.new("TextLabel")
    mazeCounterLabel.Size=UDim2.new(1,0,0,20); mazeCounterLabel.BackgroundTransparency=1
    mazeCounterLabel.Text="Candy collected: 0"; mazeCounterLabel.TextColor3=Color3.fromRGB(200,200,215)
    mazeCounterLabel.Font=Enum.Font.Gotham; mazeCounterLabel.TextSize=12
    mazeCounterLabel.LayoutOrder=10; mazeCounterLabel.Parent=mazeSection.content

    local mazeStop=nil
    local mazeToggle
    mazeToggle=createInteractive(mazeSection.content,{
        Text="Farm selected location", Desc="Candy -> Finish", Type="toggle", Order=4,
        OnToggle=function(state)
            if not state then
                if mazeStop then mazeStop(); mazeStop=nil end
                disableFarmSupport(); return
            end
            mazeCounterLabel.Text="Candy collected: 0"
            enableFarmSupport()
            local counter = 0
            local active = true
            task.spawn(function()
                local h=workspace:FindFirstChild("Halloween2026")
                local mazes=h and h:FindFirstChild("Mazes")
                local model=mazes and mazes:FindFirstChild(selectedMaze)
                if not model then
                    notifyGlobal("Maze","Location not found",Color3.fromRGB(200,80,80))
                    active=false; mazeToggle.setActive(false); disableFarmSupport(); return
                end
                local candyFolder=model:FindFirstChild("Candy")
                local finishModel=model:FindFirstChild("Finish")
                if candyFolder then
                    local visited={}
                    while active do
                        local unvisited={}
                        for _,obj in ipairs(candyFolder:GetChildren()) do
                            if (obj:IsA("Model") or obj:IsA("BasePart")) and not visited[obj] then table.insert(unvisited,obj) end
                        end
                        if #unvisited==0 then break end
                        for _,obj in ipairs(unvisited) do
                            if not active then break end
                            if visited[obj] or not obj.Parent then visited[obj]=true
                            else
                                local pos=getPosition(obj)
                                if pos then
                                    visited[obj]=true
                                    if mazeMode.get()=="tp" then teleportToExact(pos); task.wait(0.25)
                                    else travelTo(pos,function() return not active end); task.wait(0.5) end
                                    counter=counter+1; mazeCounterLabel.Text="Candy collected: "..counter
                                end
                            end
                        end
                    end
                end
                if active and finishModel then
                    local fp=getPosition(finishModel)
                    if fp then
                        if mazeMode.get()=="tp" then teleportToExact(fp) else travelTo(fp,function() return not active end) end
                        task.wait(1)
                    end
                end
                if active then
                    active=false; mazeToggle.setActive(false); disableFarmSupport()
                    notifyGlobal("Maze","Finished. Candy: "..counter,Color3.fromRGB(80,200,120))
                end
            end)
            mazeStop = function() active=false end
        end,
    })

