    local mazeMode = makeFarmModeRow(mazeSection.content, 2)
    local selectedMaze="Castle1"
    local mazeButtons={}
    local mazeBtnHolder=Instance.new("Frame")
    mazeBtnHolder.Size=UDim2.new(1,0,0,32); mazeBtnHolder.BackgroundTransparency=1
    mazeBtnHolder.LayoutOrder=3; mazeBtnHolder.Parent=mazeSection.content
